      "settings": {
        "title": "סדנאות הכנה לכיתה א', קריאה וחשבון בבאר שבע | מא-ת",
        "order": "1",
        "meta_descr": "סדנאות בקבוצות קטנות במתנ\"ס הרוח היהודית בבאר שבע: הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה לכיתות א'-ג'.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/workshops.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/workshops.html\">\n<meta property=\"og:title\" content=\"סדנאות הכנה לכיתה א', קריאה וחשבון בבאר שבע | מא-ת\">\n<meta property=\"og:description\" content=\"סדנאות בקבוצות קטנות במתנ&quot;ס הרוח היהודית בבאר שבע: הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה לכיתות א'-ג'.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Course\",\n      \"name\": \"הכנה לכיתה א'\",\n      \"description\": \"הכנה לכיתה א' בקבוצות קטנות דרך משחק וחוויה: אותיות, צלילים, חשבון ומוכנות רגשית.\",\n      \"inLanguage\": \"he\",\n      \"provider\": {\n        \"@type\": \"EducationalOrganization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"url\": \"https://merkaz-lamida-a-t.com/\"\n      }\n    },\n    {\n      \"@type\": \"Course\",\n      \"name\": \"מתמטיקה ושפה לכיתות ב'-ו'\",\n      \"description\": \"חיזוק מתמטיקה ושפה, אסטרטגיות למידה, הבנת הנקרא וכתיבה.\",\n      \"inLanguage\": \"he\",\n      \"provider\": {\n        \"@type\": \"EducationalOrganization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"url\": \"https://merkaz-lamida-a-t.com/\"\n      }\n    },\n    {\n      \"@type\": \"Course\",\n      \"name\": \"דיוק ושטף בקריאה ובכתיבה לכיתות א'-ג'\",\n      \"description\": \"קבוצות קטנות לחיזוק דיוק ושטף בקריאה ובכתיבה, פעם בשבוע.\",\n      \"inLanguage\": \"he\",\n      \"provider\": {\n        \"@type\": \"EducationalOrganization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"url\": \"https://merkaz-lamida-a-t.com/\"\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"דף הבית\",\n          \"item\": \"https://merkaz-lamida-a-t.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"הסדנאות\",\n          \"item\": \"https://merkaz-lamida-a-t.com/workshops.html\"\n        }\n      ]\n    }\n  ]\n}\n</script>"
