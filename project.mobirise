                "font-weight": "600"
              },
              ".mbr-text": {
                "margin-bottom": "2rem",
                "text-align": "center",
                "color": "#555555",
                "line-height": "1.8",
                "font-size": "1.1rem"
              },
              ".tags-wrapper": {
                "margin-bottom": "16px",
                ".tags-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "@media (max-width: 992px)": {
                    "flex-direction": "column"
                  },
                  ".mbr-tag": {
                    "border": "4px solid @tag",
                    "padding": "8px 22px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "margin": "0 0 16px 16px",
                    "border-radius": "100em",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "@media (max-width: 992px)": {
                      "margin": "0 0 16px 0"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                ".btn-primary-outline, .btn-secondary-outline, .btn-success-outline, .btn-info-outline, .btn-warning-outline, .btn-danger-outline, .btn-black-outline, .btn-white-outline": {
                  "padding": "0",
                  "border": "none !important",
                  "&:hover, &:focus": {
                    "letter-spacing": ".1em",
                    "&::after": {
                      "opacity": "0"
                    }
                  }
                }
              },
              "text-align": "right",
              "direction": "rtl",
              ".mbr-section-btn .btn": {
                "padding": "12px 35px",
                "border-radius": "50px",
                "font-weight": "600",
                "transition": "all 0.3s ease",
                "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.1)",
                "&:hover": {
                  "transform": "translateY(-3px)",
                  "box-shadow": "0 6px 20px rgba(0, 0, 0, 0.15)"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "520px",
                      "object-fit": "cover",
                      "border-radius": "0 !important"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "32px",
              "height": "32px",
              "margin-top": "-1.5rem",
              "font-size": "26px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "none",
              "border-radius": "0",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "color": "@successColor !important"
              },
              "&.embla__button--prev": {
                "right": "6rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "3rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem",
              "box-shadow": "0 15px 35px rgba(0, 0, 0, 0.1)",
              "border-radius": "15px"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#b7a284 !important",
              "text-align": "center",
              "font-weight": "700",
              "font-size": "3rem",
              "@media (max-width: 992px)": {
                "font-size": "2.2rem"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#86704f",
              "font-weight": "700",
              "font-size": "1.8rem",
              "margin-bottom": "1.5rem !important",
              "@media (max-width: 992px)": {
                "font-size": "1.5rem",
                "text-align": "center"
              }
            },
            ".mbr-text": {
              "color": "#555555 !important",
              "text-align": "right",
              "line-height": "1.8",
              "font-size": "1.3rem !important",
              "direction": "rtl",
              "@media (max-width: 992px)": {
                "font-size": "1.1rem !important",
                "text-align": "center"
              }
            },
            ".mbr-tag": {
              "color": "#b7a284 !important",
              "border-color": "#b7a284 !important",
              "font-weight": "600"
            },
            ".mbr-section-subtitle, .mbr-section-btn, .tags-wrapper": {
              "text-align": "center",
              "color": "#b7a284"
            },
            "@media (max-width: 768px)": {
              ".row": {
                "display": "flex",
                "flex-direction": "column-reverse"
              },
              ".col-12.col-lg-7": {
                "order": "1"
              },
              ".col-12.col-lg-4": {
                "order": "2"
              }
            },
            ".embla__slide .item-img img": {
              "height": "500px",
              "object-fit": "cover",
              "transition": "transform 0.5s ease",
              "&:hover": {
                "transform": "scale(1.02)"
              },
              "border-radius": "24px !important",
              "box-shadow": "0 18px 40px -22px rgba(58, 52, 28, .4)"
            },
            "@media (max-width: 992px)": {
              ".content-wrapper": {
                "text-align": "center",
                "margin-top": "2rem"
              },
              ".embla__slide .item-img img": {
                "height": "auto !important",
                "object-fit": "contain !important",
                "width": "100% !important",
                "border-radius": "12px !important"
              },
              ".embla__viewport": {
                "box-shadow": "none !important",
                "background": "transparent !important"
              },
              ".col-12.col-lg-7": {
                "margin-bottom": "25px !important"
              }
            },
            ".mbr-section-btn .btn": {
              "padding": "15px 45px !important",
              "font-size": "1.25rem !important",
              "font-weight": "600 !important",
              "border-radius": "50px !important",
              "@media (max-width: 992px)": {
                "width": "100%"
              },
              "margin-right": "0 !important",
              "margin-left": "0 !important",
              "white-space": "normal !important",
              "word-wrap": "break-word",
              "display": "inline-block",
              "max-width": "100%"
            },
            ".mbr-section-btn": {
              "padding": "0 !important",
              "margin": "0 !important",
              "text-align": "center !important",
              "width": "100%",
              "display": "flex",
              "justify-content": "center"
            },
            "@media (max-width: 767px)": {
              ".mbr-section-btn .btn": {
                "padding": "12px 25px !important",
                "font-size": "1.1rem !important",
                "width": "auto !important",
                "min-width": "200px"
              },
              ".embla__slide .item-img img": {
                "max-height": "250px"
              }
            },
            "background-image": "linear-gradient(180deg, #ffffff 0, rgba(255, 255, 255, 0) 110px, rgba(255, 255, 255, 0) calc(100% - 110px), #ffffff 100%), url(\"data:image/svg+xml;base64,\")",
            "background-size": "auto, cover",
            "background-position": "center"
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla resumem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Tags\" name=\"showTags\">\n        <input type=\"range\" inline title=\"Tags Amount\" name=\"tags\" min=\"1&quot;\" max=\"3\" step=\"1\" value=\"1\" condition=\"showTags\">\n        <input type=\"color\" title=\"Border Color\" value=\"#b7a284\" name=\"tag\" condition=\"showTags\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Shadow Color\" value=\"#b7a284\" name=\"shadow\" selected>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f4ee\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f0f0f0\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"content-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .mbr-section-btn, .tags-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><b>הערכה שלנו</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">ערכת ההכנה שלנו לכיתה א' נבנתה במיוחד כדי להעניק לילדים התחלה בטוחה ומהנה בשלב הלימודי החדש בחייהם.<br>הערכה כוללת מגוון רחב של משחקים דידקטיים וחוברות פעילות מוכנות בשפה ובחשבון, שמשלבים את כל מה שילד צריך לדעת, בקצב שלו ובסביבה רגועה ותומכת.<br>באמצעות התרגול החווייתי, הילדים:<br>רוכשים ביטחון בקריאה, בכתיבה ובחשבון<br>מפתחים כישורי חשיבה, קשב וזיכרון<br>מתרגלים מיומנויות בסיסיות בדרך מהנה ומעודדת<br>הערכה מושלמת לתרגול בבית, כהכנה למסגרת הלימודית או כהעשרה, ועוזרת לילדים להגיע ליום הראשון בכיתה א' עם חיוך, ביטחון עצמי ותחושת מוכנות.<br></p>\n                    <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                        <div class=\"tags-wrap\">\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\" mbr-theme-style=\"display-4\">לרכישת הערכה</p>\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\" mbr-theme-style=\"display-4\" mbr-if=\"tags > 1\">\n                                ערכת הכנה\n                            </p>\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\" mbr-theme-style=\"display-4\" mbr-if=\"tags > 2\">\n                                לכיתה א'\n                            </p>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-danger\" href=\"https://paypage.takbull.co.il/n05s\" data-app-placeholder=\"Type Text\" target=\"_blank\">למעבר לרכישה</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/kit-01.jpg\" alt=\"ערכת ההכנה לכיתה א' של מרכז מא-ת\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/kit-02.jpg\" alt=\"משחקים דידקטיים מתוך ערכת ההכנה לכיתה א'\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/kit-03.jpg\" alt=\"חוברות פעילות בשפה ובחשבון מתוך ערכת ההכנה\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/kit-04.jpg\" alt=\"ערכת ההכנה לכיתה א'\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "slider01-1s",
          "_isUserblock": true,
          "_cid": "u93PPr1cig",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "((@paddingBottom + 5px) * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".carousel-item": {
              "padding": "0 10%",
              "justify-content": "center",
              "-webkit-justify-content": "center"
            },
            ".carousel-item.active, .carousel-item-next, .carousel-item-prev": {
              "display": "flex"
            },
            ".img-box": {
              "position": "relative",
              "width": "fit-content",
              "margin": "auto"
            },
            ".carousel-controls .mbr-iconfont": {
              "font-family": "Moririse2 !important",
              "font-size": "1rem",
              "font-weight": "900",
              "transition": "opacity .3s"
            },
            ".carousel-controls": {
              "a": {
                "transition": "all .3s",
                "border-radius": "50%",
                "border": "none",
                "background-color": "transparent",
                "span": {
                  "color": "@arrowsColor !important",
                  "font-size": "(@arrowsSize * 5px) !important"
                },
                "&:hover": {
                  ".mobi-mbri-left": {
                    "transform": "translateX(-5px)"
                  },
                  ".mobi-mbri-right": {
                    "transform": "translateX(5px)"
                  }
                }
              },
              ".carousel-control-next, .carousel-control-prev": {
                "opacity": "1",
                "width": "44px",
                "height": "44px"
              },
              ".carousel-control-next": {
                "bottom": "auto",
                "top": "44%"
              },
              ".carousel-control-prev": {
                "bottom": "auto",
                "top": "44%"
              }
            },
            ".author-box": {
              "margin-bottom": "14px",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center"
            },
            ".face": {
              "width": "130px",
              "height": "130px",
              "border-radius": "100%",
              "box-shadow": "none",
              "margin": "0rem",
              "object-fit": "cover",
              "mix-blend-mode": "multiply"
            },
            ".author": {
              "margin": "auto 0"
            },
            ".mbr-text": {
              "margin-bottom": "34px !important"
            },
            "h3, h4": {
              "margin": "0",
              "padding": "0"
            },
            ".mbr-bottom": {
              "color": "#767676"
            },
            ".box": {
              "margin-left": "auto",
              "margin-right": "auto",
              "max-width": "800px!important"
            },
            "@media (max-width: 992px)": {
              ".carousel-controls": {
                "a": {
                  "span": {
                    "bottom": "auto",
                    "top": "30%"
                  }
                }
              }
            },
            "@media (max-width: 767px)": {
              ".carousel-controls": {
                "a": {
                  "span": {
                    "bottom": "auto",
                    "top": "20%"
                  }
                }
              }
            },
            ".carousel-indicators": {
              "bottom": "-65px",
              "@media (max-width: 786px)": {
                "bottom": "-75px"
              }
            },
            ".carousel-indicators li": {
              "margin-right": "31px",
              "margin-left": "31px",
              "opacity": "(@dotsOpacity * 0.1)",
              "width": "6px",
              "height": "6px",
              "max-width": "6px",
              "max-height": "6px",
              "min-width": "6px",
              "min-height": "6px",
              "background": "@dotsColor",
              "border": "none",
              "position": "relative",
              "transition": "0.3s",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "50%",
              "&:hover": {
                "opacity": "1 !important"
              },
              "& svg": {
                "position": "absolute",
                "display": "block",
                "width": "36px",
                "height": "36px",
                "z-index": "1",
                "fill": "none",
                "color": "@dotsColorActive",
                "stroke": "none",
                "overflow": "visible",
                "& circle": {
                  "stroke-dasharray": "110",
                  "stroke-dashoffset": "110",
                  "stroke": "@dotsColorActive",
                  "stroke-width": "1",
                  "transition": "all 0.6s cubic-bezier(0.43, 0.41, 0.36, 0.9)",
                  "transform": "rotate(-145deg)",
                  "transform-origin": "center"
                }
              }
            },
            ".carousel-indicators li.active": {
              "background": "@dotsColorActive",
              "& circle": {
                "stroke-dashoffset": "0",
                "transform": "rotate(55deg)"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "2rem",
              "color": "#3a341c"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "H1": {
              "color": "#b7a284"
            }
          },
          "_name": "testimonials2",
          "_sourceTheme": "successm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"carousel slide testimonials-slider testimonials2\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\">\n\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\" inline>\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"20\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconbgColor\" value=\"#f7e4d6\" selected>\n        <input type=\"checkbox\" title=\"Show Arrows\" name=\"showArrows\" checked>\n        <input type=\"color\" title=\"Arrow Color\" name=\"arrowsColor\" value=\"#b7a284\" condition=\"showArrows\">\n        <input type=\"range\" title=\"Arrow Size\" name=\"arrowsSize\" value=\"7\" min=\"1\" max=\"10\" step=\"1\" condition=\"showArrows\">\n        <input type=\"checkbox\" title=\"Show Dots\" name=\"dots\" checked>\n        <input type=\"color\" title=\"Dots Color\" name=\"dotsColor\" value=\"#ffffff\" condition=\"dots\">\n        <input type=\"color\" title=\"Dots Color Active\" name=\"dotsColorActive\" value=\"#645600\" condition=\"dots\">\n        <input type=\"range\" title=\"Dots Opacity\" name=\"dotsOpacity\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"dots\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/successm4/components/_images/background7.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/successm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container text-center\">\n        <div class=\"carousel slide\" data-ride=\"carousel\" data-bs-ride=\"carousel\" role=\"listbox\">\n            <ol class=\"carousel-indicators\" mbr-if=\"dots\">\n                <li data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\">\n                    <svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"1\" data-bs-slide-to=\"1\" mbr-if=\"testimonialsSlides > 1\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"2\" data-bs-slide-to=\"2\" mbr-if=\"testimonialsSlides > 2\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"3\" data-bs-slide-to=\"3\" mbr-if=\"testimonialsSlides > 3\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"4\" data-bs-slide-to=\"4\" mbr-if=\"testimonialsSlides > 4\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"5\" data-bs-slide-to=\"5\" mbr-if=\"testimonialsSlides > 5\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"6\" data-bs-slide-to=\"6\" mbr-if=\"testimonialsSlides > 6\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"7\" data-bs-slide-to=\"7\" mbr-if=\"testimonialsSlides > 7\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"8\" data-bs-slide-to=\"8\" mbr-if=\"testimonialsSlides > 8\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"9\" data-bs-slide-to=\"9\" mbr-if=\"testimonialsSlides > 9\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"10\" data-bs-slide-to=\"10\" mbr-if=\"testimonialsSlides > 10\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"11\" data-bs-slide-to=\"11\" mbr-if=\"testimonialsSlides > 11\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"12\" data-bs-slide-to=\"12\" mbr-if=\"testimonialsSlides > 12\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"13\" data-bs-slide-to=\"13\" mbr-if=\"testimonialsSlides > 13\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"14\" data-bs-slide-to=\"14\" mbr-if=\"testimonialsSlides > 14\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"15\" data-bs-slide-to=\"15\" mbr-if=\"testimonialsSlides > 15\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"16\" data-bs-slide-to=\"16\" mbr-if=\"testimonialsSlides > 16\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"17\" data-bs-slide-to=\"17\" mbr-if=\"testimonialsSlides > 17\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"18\" data-bs-slide-to=\"18\" mbr-if=\"testimonialsSlides > 18\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n                <li data-slide-to=\"19\" data-bs-slide-to=\"19\" mbr-if=\"testimonialsSlides > 19\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg></li>\n            </ol>\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item\">\n                    <div class=\"col-md-12 col-lg-12\">\n                        <div class=\"author-box\">\n                            <div class=\"img-box\">\n                                <img class=\"face\" src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-bold align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">הורים מספרים על השינוי בבית</h2>\n                        <h3 class=\"mbr-section-subtitle align-center align-center mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\">Lorem ipsum dolor sit amet</h3>\n                        <p class=\"mbr-text mbr-regular align-center mbr-fonts-style box\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\"הערכה הזו כללה את כל מה שהיינו צריכים לקראת עלייתה של בתי לכיתה א':<br>משחקים דידקטיים וחוברות מוכנות בשפה ובחשבון\n<br>שעזרו לה להרגיש מוכנה ובטוחה\"</p>\n                        <div class=\"author mbr-m-auto\">\n                            <h3 class=\"mbr-semibold pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\">שימרית\n                            </h3>\n                            <h4 class=\"mbr-semibold mbr-fonts-style mbr-bottom\" data-app-selector=\".mbr-bottom\" mbr-theme-style=\"display-7\"></h4>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item\">\n                    <div class=\"col-md-12 col-lg-12\">\n                        <div class=\"author-box\">\n                            <div class=\"img-box\">\n                                <img class=\"face\" src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-bold align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">הורים מספרים על השינוי בבית</h2>\n                        <h3 class=\"mbr-section-subtitle align-center align-center mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\">Lorem ipsum dolor sit amet</h3>\n                        <p class=\"mbr-text mbr-regular align-center mbr-fonts-style box\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">הערכה הזו הייתה בדיוק מה שחיפשתי!<br>הבת שלי התאהבה בחוברות – היא למדה לשחק עם אותיות ומספרים בלי לשים לב בכלל שהיא 'לומדת'. זה הפך את כל תקופת המעבר לכיתה א' להרבה יותר קלה ומהנה<br></p>\n                        <div class=\"author mbr-m-auto\">\n                            <h3 class=\"mbr-semibold pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\">מאיה\n                            </h3>\n                            <h4 class=\"mbr-semibold mbr-fonts-style mbr-bottom\" data-app-selector=\".mbr-bottom\" mbr-theme-style=\"display-7\"></h4>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item\">\n                    <div class=\"col-md-12 col-lg-12\">\n                        <div class=\"author-box\">\n                            <div class=\"img-box\">\n                                <img class=\"face\" src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-bold align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">הורים מספרים על השינוי בבית</h2>\n                        <h3 class=\"mbr-section-subtitle align-center align-center mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\">Lorem ipsum dolor sit amet</h3>\n                        <p class=\"mbr-text mbr-regular align-center mbr-fonts-style box\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">אהבנו במיוחד את המשחקים הדידקטיים<br>הם עזרו לבן שלי לתרגל בלי לחץ, תוך כדי משחק והנאה. הוא התחיל לזהות מילים ראשונות ולפתור תרגילים קטנים עוד לפני תחילת הלימודים. ממליץ בחום!</p>\n                        <div class=\"author mbr-m-auto\">\n                            <h3 class=\"mbr-semibold pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\">דניאל \n                            </h3>\n                            <h4 class=\"mbr-semibold mbr-fonts-style mbr-bottom\" data-app-selector=\".mbr-bottom\" mbr-theme-style=\"display-7\"></h4>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item\">\n                    <div class=\"col-md-12 col-lg-12\">\n                        <div class=\"author-box\">\n                            <div class=\"img-box\">\n                                <img class=\"face\" src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-bold align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">הורים מספרים על השינוי בבית</h2>\n                        <h3 class=\"mbr-section-subtitle align-center align-center mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\">Lorem ipsum dolor sit amet</h3>\n                        <p class=\"mbr-text mbr-regular align-center mbr-fonts-style box\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">בתור מורה לכיתה א', אני ממליצה על הערכה הזו גם להורים.<br>החומרים מדויקים, מאורגנים ונכתבו בגובה העיניים של הילד. מושלם לתרגול קליל ונעים בבית לפני תחילת השנה.</p>\n                        <div class=\"author mbr-m-auto\">\n                            <h3 class=\"mbr-semibold pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\">קרן&nbsp;</h3>\n                            <h4 class=\"mbr-semibold mbr-fonts-style mbr-bottom\" data-app-selector=\".mbr-bottom\" mbr-theme-style=\"display-7\"></h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"carousel-controls\" mbr-if=\"showArrows\">\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                    <span aria-hidden=\"true\" class=\"mbr-iconfont mobi-mbri-left mobi-mbri\"></span>\n                    <span class=\"sr-only visually-hidden\">Previous</span>\n                </a>\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                    <span aria-hidden=\"true\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                    <span class=\"sr-only visually-hidden\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uLW6JE3FOt",
          "_anchor": "testimonials2-20",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "b, strong": {
              "font-weight": "900"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            "img": {
              "filter": "drop-shadow(0 22px 28px rgba(58, 52, 28, .28))",
              "@media (min-width: 992px)": {
                "padding": "0 4rem"
              },
              "@media (max-width: 992px)": {
                "padding-bottom": "2rem"
              }
            },
            ".row": {
              "align-items": "center"
            },
            ".mbr-section-title": {
              "color": "#86704f",
              "text-align": "center"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#645600",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#b7a284",
              "text-align": "center"
            },
            "background-image": "linear-gradient(180deg, #ffffff 0, rgba(255, 255, 255, 0) 110px, rgba(255, 255, 255, 0) calc(100% - 110px), #ffffff 100%), url(\"data:image/svg+xml;base64,\")",
            "background-size": "auto, cover",
            "background-position": "center"
          },
          "_name": "people03",
          "_sourceTheme": "nichem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"nichem5 people3\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"0.1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/nichem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f4ee\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/nichem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}} image-wrapper\">\n                <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/hadar-nazrit-reuven.jpg\" alt=\"הדר נזרית-ראובן, מרכז למידה מא-ת בבאר שבע\">\n            </div>\n            <div class=\"col-12 col-lg col-md-12\">\n                <div class=\"text-wrapper align-left\">\n                    <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showsubTitle\"><b>קצת עליי ועל העסק</b></h2>\n                    <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>נעים להכיר, הדר נזרית-ראובן</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">תושבת באר שבע, בעלת תואר ראשון בחינוך מיוחד ומומחית להוראה מתקנת עם 15 שנות ניסיון. אני מאמינה בבניית תוכנית עבודה אישית לכל תלמיד, המשלבת צמצום פערים לימודיים בשפה ובמתמטיקה יחד עם מעטפת רגשית וחברתית. המטרה שלי היא ליצור סביבה מעוררת השראה שתעניק לילדכם ביטחון ותחושת מסוגלות. בואו נבנה יחד את הגרסה הטובה ביותר של ילדכם.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-primary\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">לתיאום שיחה</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u4V75tnHJE",
          "_anchor": "people03-k",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "direction": "rtl",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-overlay": {
              "background-color": "@overlayColor"
            },
            ".mbr-section-subtitle": {
              "letter-spacing": "1px",
              "margin-bottom": "2px",
              "color": "#86704f",
              "text-transform": "uppercase"
            },
            ".mbr-section-title": {
              "font-weight": "700",
              "margin-bottom": "10px",
              "color": "#86704f"
            },
            ".title__block": {
              "margin-bottom": "10px"
            },
            ".card": {
              "margin-bottom": "30px"
            },
            ".card__wrap": {
              "background": "@cardColor",
              "position": "relative",
              "padding": "40px 30px",
              "height": "100%",
              "z-index": "1",
              "transition": "all 0.3s",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "text-align": "center",
              "&:before": {
                "content": "\"\"",
                "width": "100%",
                "height": "100%",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "border": "1px solid @borderColor",
                "background": "@hoverCardColor",
                "z-index": "-1",
                "transform": "scale(1, 0)",
                "transition": "all 0.4s ease-in-out"
              },
              "&:hover": {
                "&:before": {
                  "transform": "scale(1, 1)"
                },
                ".card-title, .mbr-text, .card__icon span": {
                  "color": "@cardColor !important"
                }
              },
              "border-radius": "24px",
              "overflow": "hidden",
              "box-shadow": "0 18px 40px -22px rgba(58, 52, 28, .4)",
              "background-image": "linear-gradient(160deg, rgba(255, 255, 255, .16), rgba(58, 52, 28, .08))"
            },
            ".card__icon span": {
              "font-size": "50px",
              "color": "#ffffff",
              "transition": "color 0.3s"
            },
            ".card-title": {
              "font-weight": "700",
              "margin-top": "20px",
              "color": "#ffffff",
              "transition": "color 0.3s"
            },
            ".mbr-text": {
              "line-height": "1.6",
              "margin-top": "15px",
              "color": "#ffffff",
              "transition": "color 0.3s"
            },
            "@media (max-width: 767px)": {
              ".card__wrap": {
                "padding": "30px 20px"
              }
            },
            ".card__wrap:hover": {
              "transform": "translateY(-6px)"
            },
            ".card__icon": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "84px",
              "height": "84px",
              "border-radius": "50%",
              "background": "rgba(255, 255, 255, .16)"
            }
          },
          "_name": "features6",
          "_sourceTheme": "modernm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features6 modernm4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        \n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        \n        <header>Card Appearance</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Card Color\" value=\"#b7a284\" name=\"cardColor\">\n        <input type=\"color\" title=\"Hover Card Color\" value=\"#ffffff\" name=\"hoverCardColor\">\n        <input type=\"color\" title=\"Border Color\" value=\"#b7a284\" name=\"borderColor\">\n        \n        <select title=\"Cards Amount\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background/backgraund__trend.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://youtu.be/iM-NestDPNQ\">\n        </fieldset>\n        \n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <!-- כותרות הסקשן -->\n            <div class=\"col-lg-12 title__block align-center\" mbr-if=\"showSubtitle || showTitle\">\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\">\n                    <b>15 שנים של ניסיון. מאות הצלחות. דרך אחת מדויקת.</b>\n                </h4>\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\">\n                    למה הורים וילדים בוחרים להצליח איתי?\n                </h3>\n            </div>\n\n            <!-- כרטיס 1 -->\n            <div class=\"card col-md-6 col-lg-4\">\n                <div class=\"card__wrap\">\n                    <div class=\"card__icon\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-target\" style=\"color: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">הדיוק שבפשטות</h4>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                            פיתחתי שיטה ייחודית שמתמקדת בעיקר: זיקוק הקושי והפיכתו להבנה עמוקה. בתוכנית שלי, כל תרגיל נבחר בקפידה כדי להוביל לתוצאה המהירה ביותר.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- כרטיס 2 -->\n            <div class=\"card col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card__wrap\">\n                    <div class=\"card__icon\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">קודם כל הלב</h4>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                            למידה לא קורה בלי ביטחון. אני חורטת על דגלי חיבור רגשי עמוק ורגישות לצרכי הילד. כשהילד מרגיש שרואים אותו – הפערים נסגרים כמעט מעצמם.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- כרטיס 3 -->\n            <div class=\"card col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card__wrap\">\n                    <div class=\"card__icon\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-star\" style=\"color: rgb(255, 255, 255);\"></span>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">הגרסה הטובה ביותר</h4>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                            הילדים במרכז עוברים תהליך של צעדים קטנים ואיכותיים, בסיומם הם מגיעים לבשלות מקסימלית, ביטחון עצמי גבוה וידע רב לפי תוכנית משרד החינוך.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "u4h4NIHCQ3",
          "_anchor": "features6-4",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider04",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "@media (min-width: 768px)": {
                  "padding": "0"
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            "& when (@draggable)": {
              ".embla__slide a": {
                "cursor": "grab"
              },
              ".embla__slide a:active": {
                "cursor": "grabbing"
              }
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".embla__slide": {
              "position": "relative",
              "min-width": "490px",
              "max-width": "490px",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              "a": {
                "display": "block",
                "width": "100%"
              }
            },
            ".item-menu-overlay": {
              "border-radius": "2rem"
            },
            ".mbr-section-title": {
              "color": "#86704f"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            ".mbr-box": {
              "color": "#ffffff"
            },
            ".slide-content": {
              "position": "relative",
              "border-radius": "4px",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap"
            },
            "img, .item-img": {
              "filter": "box-shadow(10px 7px 10px #b7a284)",
              "width": "100%",
              "& when (@autoSize)": {
                "height": "(@carouselHeight * 100px)",
                "object-fit": "cover"
              }
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".slide-content img, .item-img img": {
              "border-radius": "20px"
            },
            "background-image": "linear-gradient(180deg, #ffffff 0, rgba(255, 255, 255, 0) 110px, rgba(255, 255, 255, 0) calc(100% - 110px), #ffffff 100%), url(\"data:image/svg+xml;base64,\")",
            "background-size": "auto, cover",
            "background-position": "center"
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider4 mbr-embla\" group=\"Gallery &amp; Slider\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline=\"\" type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input inline=\"\" type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked=\"\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <header>Card</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked=\"\">\n        <input type=\"range\" name=\"carouselHeight\" title=\"Height\" min=\"1\" max=\"8\" step=\"1\" value=\"5\" condition=\"autoSize\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"assets/images/background1.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f4ee\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked=\"\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <div class=\"col-12 content-head\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\">\n                    מגלים את היכולות ברגע של למידה\n                </h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\">\n                    רגעים קטנים של הצלחה מתוך העבודה במרכז\n                </h5>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla position-relative\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            <!-- Slide 1 -->\n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-01.jpg\" data-slide-to=\"0\" data-bs-slide-to=\"0\" alt=\"רגע של למידה במרכז מא-ת בבאר שבע\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-02.jpg\" data-slide-to=\"1\" data-bs-slide-to=\"1\" alt=\"הדר נזרית-ראובן במרכז הלמידה\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-03.jpg\" data-slide-to=\"2\" data-bs-slide-to=\"2\" alt=\"פעילות לימודית במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-04.jpg\" data-slide-to=\"3\" data-bs-slide-to=\"3\" alt=\"למידת שפה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-05.jpg\" data-slide-to=\"4\" data-bs-slide-to=\"4\" alt=\"למידה בקבוצה קטנה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-06.jpg\" data-slide-to=\"5\" data-bs-slide-to=\"5\" alt=\"תרגול שפה וחשבון במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-07.jpg\" data-slide-to=\"6\" data-bs-slide-to=\"6\" alt=\"תרגול שפה וחשבון במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-08.jpg\" data-slide-to=\"7\" data-bs-slide-to=\"7\" alt=\"דיוק ושטף בקריאה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-09.jpg\" data-slide-to=\"8\" data-bs-slide-to=\"8\" alt=\"דיוק ושטף בקריאה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-10.jpg\" data-slide-to=\"9\" data-bs-slide-to=\"9\" alt=\"דיוק ושטף בקריאה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-11.jpg\" data-slide-to=\"10\" data-bs-slide-to=\"10\" alt=\"דיוק ושטף בקריאה במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-12.jpg\" data-slide-to=\"11\" data-bs-slide-to=\"11\" alt=\"הכנה לכיתה א' במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-13.jpg\" data-slide-to=\"12\" data-bs-slide-to=\"12\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-img\">\n                                        <div class=\"item-wrapper\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/gallery-14.jpg\" data-slide-to=\"13\" data-bs-slide-to=\"13\" alt=\"מקום לילדים במרכז מא-ת\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- Slide 2 -->\n                            \n\n                            <!-- Slide 3 -->\n                            \n\n                            <!-- Slide 4 -->\n                            \n\n                            <!-- Slide 5 -->\n                            \n\n                            <!-- Slide 6 -->\n                            \n\n                            <!-- Slide 7 -->\n                            \n\n                            <!-- Slide 8 -->\n                            \n\n                            <!-- Slide 9 -->\n                            \n\n                            <!-- Slide 10 -->\n                            \n\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "slider04-2",
