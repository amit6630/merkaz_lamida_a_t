    "article-middle-school.html": {
      "settings": {
        "title": "המעבר מיסודי לחטיבת ביניים | מרכז למידה מא-ת",
        "order": "4",
        "meta_descr": "המעבר מכיתה ו' לחטיבת הביניים מביא איתו יותר מקצועות, יותר מורים ויותר עצמאות. מה משתנה, אילו מיומנויות כדאי לחזק בכיתות ה'-ו', ואיך הורים יכולים לעזור.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/article-middle-school.html\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/article-middle-school.html\">\n<meta property=\"og:title\" content=\"המעבר מיסודי לחטיבת ביניים | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"המעבר מכיתה ו' לחטיבת הביניים מביא איתו יותר מקצועות, יותר מורים ויותר עצמאות. מה משתנה, אילו מיומנויות כדאי לחזק בכיתות ה'-ו', ואיך הורים יכולים לעזור.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/service-math-language.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Article\",\n      \"headline\": \"המעבר מיסודי לחטיבת ביניים: איך מכינים את הילד לקפיצת המדרגה\",\n      \"description\": \"המעבר מכיתה ו' לחטיבת הביניים מביא איתו יותר מקצועות, יותר מורים ויותר עצמאות. מה משתנה, אילו מיומנויות כדאי לחזק בכיתות ה'-ו', ואיך הורים יכולים לעזור.\",\n      \"inLanguage\": \"he\",\n      \"url\": \"https://merkaz-lamida-a-t.com/article-middle-school.html\",\n      \"mainEntityOfPage\": \"https://merkaz-lamida-a-t.com/article-middle-school.html\",\n      \"image\": \"https://merkaz-lamida-a-t.com/assets/images/service-math-language.jpg\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"הדר נזרית-ראובן\",\n        \"jobTitle\": \"מורה להוראה מתקנת\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\"\n        }\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"דף הבית\",\n          \"item\": \"https://merkaz-lamida-a-t.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"מאמרים\",\n          \"item\": \"https://merkaz-lamida-a-t.com/articles.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": \"המעבר מיסודי לחטיבת ביניים\",\n          \"item\": \"https://merkaz-lamida-a-t.com/article-middle-school.html\"\n        }\n      ]\n    }\n  ]\n}\n</script>",
