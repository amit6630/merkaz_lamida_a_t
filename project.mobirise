        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bg-value",
            ".mbr-section-title": {
              "color": "#b7a284"
            },
            ".form-control": {
              "text-align": "right",
              "background-color": "#ffffff",
              "border-radius": "10px",
              "border": "1px solid #e0e0e0",
              "padding": "1rem",
              "transition": "all 0.3s",
              "&:focus": {
                "border-color": "#b7a284",
                "box-shadow": "0 0 0 0.2rem rgba(183, 162, 132, 0.25)"
              }
            },
            "textarea.form-control": {
              "min-height": "150px"
            },
            ".mbr-section-btn": {
              "width": "100%",
              ".btn": {
                "width": "100%",
                "padding": "1rem",
                "border-radius": "10px",
                "font-weight": "700",
                "letter-spacing": "1px",
                "background-color": "#b7a284 !important",
                "border-color": "#b7a284 !important",
                "color": "#ffffff !important",
                "&:hover": {
                  "background-color": "#a38d6d !important",
                  "transform": "translateY(-2px)"
                }
              }
            },
            ".alert": {
