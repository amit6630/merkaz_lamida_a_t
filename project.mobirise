              "color": "@mainColor",
              "font-weight": "700",
              "letter-spacing": ".06em",
              "margin-bottom": ".8rem"
            },
            ".ma-wh-title": {
              "color": "@textColor",
              "line-height": "1.05",
              "margin-bottom": "1.1rem"
            },
            ".ma-wh-lead": {
              "color": "#4a4434",
              "font-size": "1.15rem",
              "line-height": "1.7",
              "max-width": "34ch",
              "margin-bottom": "1.2rem"
            },
            ".ma-facts": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px",
