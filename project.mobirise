    "articles.html": {
      "settings": {
        "title": "מאמרים להורים | מרכז למידה מא-ת בבאר שבע",
        "order": "2",
        "meta_descr": "מאמרים להורים ממרכז למידה מא-ת: המעבר לכיתה א', המעבר לחטיבת הביניים, דיוק ושטף בקריאה ואסטרטגיות למידה בשפה ובחשבון.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/articles.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/articles.html\">\n<meta property=\"og:title\" content=\"מאמרים להורים | מרכז למידה מא-ת בבאר שבע\">\n<meta property=\"og:description\" content=\"מאמרים להורים ממרכז למידה מא-ת: המעבר לכיתה א', המעבר לחטיבת הביניים, דיוק ושטף בקריאה ואסטרטגיות למידה בשפה ובחשבון.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/service-first-grade.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"CollectionPage\",\n      \"name\": \"מאמרים להורים\",\n      \"url\": \"https://merkaz-lamida-a-t.com/articles.html\",\n      \"inLanguage\": \"he\",\n      \"hasPart\": [\n        {\n          \"@type\": \"Article\",\n          \"headline\": \"המעבר מגן חובה לכיתה א': איך מגיעים מוכנים, רגועים ובטוחים\",\n          \"url\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\"\n        },\n        {\n          \"@type\": \"Article\",\n          \"headline\": \"המעבר מיסודי לחטיבת ביניים: איך מכינים את הילד לקפיצת המדרגה\",\n          \"url\": \"https://merkaz-lamida-a-t.com/article-middle-school.html\"\n        },\n        {\n          \"@type\": \"Article\",\n          \"headline\": \"דיוק ושטף בקריאה, ואסטרטגיות למידה בשפה ובחשבון\",\n          \"url\": \"https://merkaz-lamida-a-t.com/article-reading-fluency.html\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"דף הבית\",\n          \"item\": \"https://merkaz-lamida-a-t.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"מאמרים\",\n          \"item\": \"https://merkaz-lamida-a-t.com/articles.html\"\n        }\n      ]\n    }\n  ]\n}\n</script>",
