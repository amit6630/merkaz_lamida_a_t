        {
          "_name": "features09",
          "_sourceTheme": "progressm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features09 progressm5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- הפרמטרים נשארים כפי שהיו אצלך -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n    </mbr-parameters>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-wrapper\" mbr-if=\"showTitle\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\"><b>כל הכלים שהילד שלך צריך במקום אחד</b></h2>\n            </div>\n        </div>\n\n        <div class=\"row items-wrapper\">\n            <!-- כרטיס 1 -->\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <a href=\"page1.html#timeline3-g\" class=\"item-link\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"image-wrap\">\n                            <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-07-31-10.36.10-c2a7e02e-720x960.jpg\" alt=\"הכנה לכיתה א\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\">הכנה לכיתה א</h4>\n                        </div>\n                    </div>\n                </a>\n            </div>\n\n            <!-- כרטיס 2 -->\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <a href=\"page1.html#timeline3-y\" class=\"item-link\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"image-wrap\">\n                            <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-07-31-10.35.29-a7f30d4c-720x540.jpg\" alt=\"שכבות )ב'-ו')\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\">מתמטיקה ושפה (ב'-ו')</h4>\n                        </div>\n                    </div>\n                </a>\n            </div>\n\n            <!-- כרטיס 3 -->\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <a href=\"page1.html#timeline3-15\" class=\"item-link\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"image-wrap\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-06-18-at-5.35.33-pm.jpeg-816x1451.jpg\" alt=\"דיוק ושטף קריאה\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\">דיוק ושטף קריאה וכתיבה כיתות א</h4>\n                        </div>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content-wrapper": {
              "margin-bottom": "2rem",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#b7a284"
            },
            ".items-wrapper": {
              "justify-content": "center"
            },
            ".item": {
              "margin-bottom": "2rem",
              ".item-wrapper": {
                "position": "relative",
                "overflow": "hidden",
                "border-radius": "15px",
                "transition": "all 0.3s ease-in-out",
                "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.1)",
                "&:hover": {
                  "transform": "translateY(-5px)",
                  "box-shadow": "0 10px 25px rgba(0, 0, 0, 0.2)",
                  "img": {
                    "transform": "scale(1.05)"
                  },
                  ".item-content": {
                    "background": "rgba(183, 162, 132, 0.9) !important"
                  }
                },
                ".image-wrap": {
                  "height": "400px",
                  "img": {
                    "width": "100%",
                    "height": "100%",
                    "object-fit": "cover",
                    "transition": "transform 0.5s ease"
                  }
                },
                ".item-content": {
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "right": "0",
                  "padding": "20px",
                  "background": "rgba(0, 0, 0, 0.5)",
                  "transition": "all 0.3s ease",
                  "text-align": "center",
                  "pointer-events": "none",
                  ".item-title": {
                    "color": "#ffffff !important",
                    "margin": "0",
                    "font-weight": "700"
                  }
                }
              }
            },
            ".item-link": {
              "text-decoration": "none !important"
            }
          },
