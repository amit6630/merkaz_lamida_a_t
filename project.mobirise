        {
          "_name": "footer02",
          "_sourceTheme": "tastem4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value>\n            <input type=\"color\" title=\"Background Color\" value=\"#b7a284\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\"><a href=\"https://thebwas.com\" class=\"text-white\" target=\"_blank\">האתר נבנה על ידי עמית שכטר</a>, <a href=\"tel:+972537155757\" class=\"text-white\">053-715-5757</a>&nbsp;<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "footer02-1d",
          "_isUserblock": true,
          "_cid": "u89OV70sBN",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "article-first-grade.html": {
      "settings": {
        "title": "המעבר מגן חובה לכיתה א' | מרכז למידה מא-ת",
        "order": "3",
        "meta_descr": "המעבר מגן חובה לכיתה א' הוא אחד השלבים המרגשים והמאתגרים בחיי הילד. מה זה בעצם \"מוכנות לכיתה א'\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/article-first-grade.html\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/article-first-grade.html\">\n<meta property=\"og:title\" content=\"המעבר מגן חובה לכיתה א' | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"המעבר מגן חובה לכיתה א' הוא אחד השלבים המרגשים והמאתגרים בחיי הילד. מה זה בעצם &quot;מוכנות לכיתה א'&quot;, אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/service-first-grade.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Article\",\n      \"headline\": \"המעבר מגן חובה לכיתה א': איך מגיעים מוכנים, רגועים ובטוחים\",\n      \"description\": \"המעבר מגן חובה לכיתה א' הוא אחד השלבים המרגשים והמאתגרים בחיי הילד. מה זה בעצם \\\"מוכנות לכיתה א'\\\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה.\",\n      \"inLanguage\": \"he\",\n      \"url\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\",\n      \"mainEntityOfPage\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\",\n      \"image\": \"https://merkaz-lamida-a-t.com/assets/images/service-first-grade.jpg\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"הדר נזרית-ראובן\",\n        \"jobTitle\": \"מורה להוראה מתקנת\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\"\n        }\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"דף הבית\",\n          \"item\": \"https://merkaz-lamida-a-t.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"מאמרים\",\n          \"item\": \"https://merkaz-lamida-a-t.com/articles.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": \"המעבר מגן חובה לכיתה א'\",\n          \"item\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\"\n        }\n      ]\n    }\n  ]\n}\n</script>",
