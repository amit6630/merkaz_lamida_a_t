        "meta_descr": "מרכז למידה מא-ת בבאר שבע של הדר נזרית-ראובן, 15 שנות ניסיון בהוראה מתקנת: הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה ובכתיבה.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/\">\n<meta property=\"og:title\" content=\"מרכז למידה מא-ת | הוראה מתקנת והכנה לכיתה א' בבאר שבע\">\n<meta property=\"og:description\" content=\"מרכז למידה מא-ת בבאר שבע של הדר נזרית-ראובן, 15 שנות ניסיון בהוראה מתקנת: הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה ובכתיבה.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n    \"LocalBusiness\",\n    \"EducationalOrganization\"\n  ],\n  \"name\": \"מרכז למידה מא-ת\",\n  \"description\": \"מרכז למידה מא-ת בבאר שבע של הדר נזרית-ראובן, 15 שנות ניסיון בהוראה מתקנת: הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה ובכתיבה.\",\n  \"url\": \"https://merkaz-lamida-a-t.com/\",\n  \"logo\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\",\n  \"image\": \"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\",\n  \"telephone\": \"+972-54-398-2557\",\n  \"email\": \"hadar30484@walla.com\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"מתנ״ס הרוח היהודית\",\n    \"addressLocality\": \"באר שבע\",\n    \"addressCountry\": \"IL\"\n  },\n  \"areaServed\": \"באר שבע\",\n  \"founder\": {\n    \"@type\": \"Person\",\n    \"name\": \"הדר נזרית-ראובן\",\n    \"jobTitle\": \"מורה להוראה מתקנת\"\n  },\n  \"sameAs\": [\n    \"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%A