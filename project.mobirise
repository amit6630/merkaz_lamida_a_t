            "backdrop-filter": "saturate(160%) blur(14px)",
            "border-bottom": "1px solid rgba(154, 130, 98, .18)",
            "box-shadow": "0 10px 30px -24px rgba(58, 52, 28, .5)",
            ".ma-toggle": {
              "position": "absolute",
              "opacity": "0",
              "pointer-events": "none",
              "width": "1px",
              "height": "1px"
            },
            ".ma-bar": {
              "max-width": "1260px",
              "margin": "0 auto",
              "height": "80px",
              "padding": "0 clamp(16px, 3vw, 36px)",
