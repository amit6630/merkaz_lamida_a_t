        {
          "_name": "mc-card",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "background-image": "radial-gradient(1200px 520px at 85% -10%, rgba(183, 162, 132, .18), transparent 60%), radial-gradient(900px 600px at -10% 110%, rgba(154, 130, 98, .14), transparent 60%), url(\"data:image/svg+xml;base64,\")",
            "direction": "rtl",
            "color": "#3a341c",
            ".mc-layout": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "40px",
              "align-items": "center",
              "max-width": "1040px",
              "margin": "0 auto"
            },
            "@media (min-width: 992px)": {
              ".mc-layout": {
                "grid-template-columns": "1.05fr 1fr",
                "gap": "56px"
              }
            },
            ".mc-stage": {
              "display": "grid",
              "justify-items": "center",
              "gap": "18px",
              "position": "relative"
            },
            ".mc-flip-toggle": {
              "position": "absolute",
              "opacity": "0",
              "width": "1px",
              "height": "1px",
              "pointer-events": "none"
            },
            ".mc-tilt": {
              "display": "block",
              "perspective": "1400px",
              "width": "100%",
              "max-width": "440px",
              "margin": "0",
              "cursor": "pointer"
            },
            ".mc-bcard": {
              "display": "block",
              "position": "relative",
              "aspect-ratio": "1.62",
              "transform-style": "preserve-3d",
              "transition": "transform .9s cubic-bezier(.2, .8, .2, 1)"
            },
            ".mc-flip-toggle:checked ~ .mc-tilt .mc-bcard": {
              "transform": "rotateY(180deg)"
            },
            ".mc-face": {
              "position": "absolute",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "left": "0",
              "border-radius": "22px",
              "overflow": "hidden",
              "backface-visibility": "hidden",
              "-webkit-backface-visibility": "hidden",
              "box-shadow": "0 30px 60px -20px rgba(58, 52, 28, .45)"
            },
            ".mc-face--front": {
              "background": "#ffffff",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "justify-content": "flex-start",
              "text-align": "center"
            },
            ".mc-face--front img": {
              "height": "70%",
              "width": "auto",
              "max-width": "88%",
              "object-fit": "contain",
              "margin-top": "4%",
              "border-radius": "0"
            },
            ".mc-front-tag": {
              "position": "absolute",
              "bottom": "0",
              "left": "0",
              "right": "0",
              "height": "24%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "padding": "0 16px",
              "color": "#ffffff",
              "font-weight": "500",
              "font-size": "1rem",
              "background": "linear-gradient(100deg, @darkColor, @mainColor 55%, @accentColor)"
            },
            ".mc-face--back": {
              "transform": "rotateY(180deg)",
              "background": "linear-gradient(140deg, @darkColor, @mainColor)",
              "color": "#ffffff",
              "display": "flex",
              "align-items": "center",
              "gap": "20px",
              "padding": "22px 24px"
            },
            ".mc-qr": {
              "flex": "none",
              "background": "#ffffff",
              "border-radius": "14px",
              "padding": "10px",
              "width": "140px"
            },
            ".mc-qr svg": {
              "display": "block",
              "width": "100%",
              "height": "auto"
            },
            ".mc-back-text": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "2px",
              "text-align": "right",
              "font-weight": "500",
              "font-size": ".9rem"
            },
            ".mc-back-line[dir=\"ltr\"]": {
              "text-align": "right"
            },
            ".mc-back-title": {
              "font-weight": "700",
              "font-size": "1.05rem",
              "margin-bottom": "6px"
            },
            ".mc-flip-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "margin": "0",
              "border": "1px solid rgba(154, 130, 98, .2)",
              "color": "@mainColor",
              "font-weight": "500",
              "font-size": "1rem",
              "padding": "8px 18px",
              "border-radius": "999px",
              "cursor": "pointer",
              "background": "rgba(255, 255, 255, .6)"
            },
            ".mc-flip-btn:hover": {
              "background": "#ffffff"
            },
            ".mc-flip-toggle:focus-visible ~ .mc-flip-btn": {
              "outline": "3px solid @accentColor",
              "outline-offset": "3px"
            },
            ".mc-to-front": {
              "display": "none"
            },
            ".mc-flip-toggle:checked ~ .mc-flip-btn .mc-to-front": {
              "display": "inline"
            },
            ".mc-flip-toggle:checked ~ .mc-flip-btn .mc-to-qr": {
              "display": "none"
            },
            ".mc-eyebrow": {
              "margin": "0",
              "color": "@accentColor",
              "font-weight": "700",
              "letter-spacing": ".14em",
              "font-size": ".8rem",
              "text-align": "right"
            },
            ".mc-title": {
              "margin": "6px 0 4px",
              "font-weight": "700",
              "font-size": "2.8rem",
              "line-height": "1.1",
              "color": "@darkColor",
              "text-align": "right",
              "font-family": "'Fredoka', sans-serif"
            },
            ".mc-lead": {
              "margin": "0 0 22px",
              "color": "#6b6352",
              "font-weight": "500",
              "font-size": "1.05rem",
              "text-align": "right"
            },
            ".mc-actions": {
              "display": "grid",
              "grid-template-columns": "repeat(2, 1fr)",
              "gap": "12px"
            },
            ".mc-act": {
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "padding": "14px 16px",
              "min-height": "64px",
              "border-radius": "16px",
              "text-decoration": "none !important",
              "color": "#3a341c !important",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .14)",
              "box-shadow": "0 6px 18px -12px rgba(58, 52, 28, .35)",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".mc-act:hover": {
              "transform": "translateY(-2px)",
              "border-color": "rgba(154, 130, 98, .35)",
              "box-shadow": "0 14px 26px -14px rgba(58, 52, 28, .45)"
            },
            ".mc-ic": {
              "flex": "none",
              "width": "40px",
              "height": "40px",
              "border-radius": "12px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "rgba(154, 130, 98, .08)",
              "color": "@mainColor",
              "font-size": "20px"
            },
            ".mc-act-text": {
              "display": "flex",
              "flex-direction": "column",
              "min-width": "0",
              "text-align": "right"
            },
            ".mc-act-title": {
              "font-weight": "700",
              "font-size": ".98rem"
            },
            ".mc-act-sub": {
              "font-weight": "500",
              "font-size": ".82rem",
              "color": "#6b6352",
              "text-align": "right",
              "overflow-wrap": "anywhere"
            },
            ".mc-act--primary": {
              "background": "linear-gradient(100deg, @darkColor, @mainColor)",
              "color": "#ffffff !important",
              "border-color": "transparent"
            },
            ".mc-act--primary .mc-ic": {
              "background": "rgba(255, 255, 255, .14)",
              "color": "#ffffff"
            },
            ".mc-act--primary .mc-act-sub": {
              "color": "rgba(255, 255, 255, .8)"
            },
            ".mc-act--wa .mc-ic": {
              "background": "rgba(37, 211, 102, .12)",
              "color": "#128c4a"
            },
            ".mc-sub": {
              "margin": "26px 0 10px",
              "font-weight": "700",
              "font-size": "1rem",
              "color": "@darkColor",
              "text-align": "right"
            },
            ".mc-chips": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px"
            },
            ".mc-chips a": {
              "padding": "7px 14px",
              "border-radius": "999px",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .14)",
              "color": "#3a341c !important",
              "text-decoration": "none !important",
              "font-weight": "500",
              "font-size": ".92rem"
            },
            ".mc-chips a:hover": {
              "border-color": "@mainColor",
              "color": "@mainColor !important"
            },
            ".mc-social": {
              "display": "flex",
              "gap": "10px"
            },
            ".mc-social a": {
              "width": "46px",
              "height": "46px",
              "border-radius": "50%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .14)",
              "color": "@mainColor !important",
              "font-size": "20px",
              "text-decoration": "none !important"
            },
            ".mc-social a:hover": {
              "background": "@mainColor",
              "color": "#ffffff !important"
            },
            "@media (max-width: 767px)": {
              ".mc-title": {
                "font-size": "2.1rem"
              },
              ".mc-qr": {
                "width": "108px"
              },
              ".mc-face--back": {
                "padding": "16px",
                "gap": "14px"
              },
              ".mc-back-text": {
                "font-size": ".8rem"
              }
            },
            "@media (max-width: 380px)": {
              ".mc-actions": {
                "grid-template-columns": "1fr"
              }
            },
            "@media (prefers-reduced-motion: reduce)": {
              ".mc-bcard": {
                "transition": "none"
              }
            },
            "font-family": "'Rubik', sans-serif",
            ".mc-panel *, .mc-stage *": {
              "font-family": "inherit"
            },
            ".mc-panel": {
              "text-align": "right"
            },
            "background-size": "auto, auto, cover"
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mc-card\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Dark\" name=\"darkColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Accent\" name=\"accentColor\" value=\"#b7a284\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#f8f4ee\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"mc-layout\">\n      <div class=\"mc-stage\">\n        <input type=\"checkbox\" id=\"mcFlip\" class=\"mc-flip-toggle\" aria-label=\"הפיכת הכרטיס לקוד QR\">\n        <label for=\"mcFlip\" class=\"mc-tilt\">\n          <span class=\"mc-bcard\">\n            <span class=\"mc-face mc-face--front\">\n              <img src=\"@PROJECT_PATH@/assets/images/logo-card.jpg\" alt=\"מא' ועד ת' – הדר נזרית-ראובן, מורה להוראה מתקנת\" width=\"680\" height=\"430\">\n              <span class=\"mc-front-tag\" mbr-text data-app-selector=\".mc-front-tag\">הוראה מתקנת · הכנה לכיתה א' · שפה וחשבון</span>\n            </span>\n            <span class=\"mc-face mc-face--back\">\n              <span class=\"mc-qr\"><svg role=\"img\" aria-label=\"קוד QR לכרטיס הביקור\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 29 29\" shape-rendering=\"crispEdges\"><path fill=\"#3a341c\" d=\"M0 0h1v1h-1zM1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM4 0h1v1h-1zM5 0h1v1h-1zM6 0h1v1h-1zM9 0h1v1h-1zM12 0h1v1h-1zM14 0h1v1h-1zM16 0h1v1h-1zM18 0h1v1h-1zM19 0h1v1h-1zM20 0h1v1h-1zM22 0h1v1h-1zM23 0h1v1h-1zM24 0h1v1h-1zM25 0h1v1h-1zM26 0h1v1h-1zM27 0h1v1h-1zM28 0h1v1h-1zM0 1h1v1h-1zM6 1h1v1h-1zM10 1h1v1h-1zM11 1h1v1h-1zM14 1h1v1h-1zM15