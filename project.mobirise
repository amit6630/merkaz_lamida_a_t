              "opacity": "0",
              "visibility": "hidden",
              "transform": "translateY(6px)",
              "transition": "opacity .25s, transform .25s, visibility .25s"
            },
            ".ma-sub::before": {
              "content": "''",
              "position": "absolute",
              "top": "-10px",
              "right": "0",
              "left": "0",
              "height": "10px"
            },
            ".ma-has-sub:hover .ma-sub, .ma-has-sub:focus-within .ma-sub": {
