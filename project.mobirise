        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/privacy.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/privacy.html\">\n<meta property=\"og:title\" content=\"מדיניות פרטיות | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"מדיניות הפרטיות של מרכז למידה מא-ת: איזה מידע נאסף באתר, למה הוא משמש, עוגיות, והזכויות שלכם לפי חוק הגנת הפרטיות.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/logo-card.jpg\">",
