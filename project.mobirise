il{to{clip-path:inset(0 0 100% 0);pointer-events:none}}.ma-pl-inner{display:grid;justify-items:center;gap:.55rem;text-align:center;transition:opacity .6s ease,transform .7s cubic-bezier(.22,1,.36,1)}#ma-pl.is-out .ma-pl-inner{opacity:0;transform:translateY(-34px)}.ma-pl-line{display:block;overflow:hidden;padding:.06em 0}.ma-pl-line>span{display:block;animation:maUp 1s cubic-bezier(.22,1,.36,1) both}.ma-pl-kick>span{font:500 1rem/1.4 \"Rubik\",sans-serif;letter-spacing:.08em;color:#d9c7a8}.ma-pl-name>span{font:600 clamp(3.2rem,10vw,7rem)/1 \"Fredoka\",sans-serif;color:#f8f4ee;animation-delay:.08s}.ma-pl-role>span{font:400 clamp(.95rem,2.4vw,1.15rem)/1.5 \"Rubik\",sans-serif;color:rgba(248,244,238,.78);animation-delay:.2s}.ma-pl-bar{width:180px;height:2px;margin-top:1.1rem;border-radius:2px;overflow:hidden;background:rgba(248,244,238,.18)}.ma-pl-bar i{display:block;height:100%;background:linear-gradient(90deg,#b7a284,#f1dfba);transform-origin:right;animation:maBar 1.3s cubic-bezier(.77,0,.18,1) .2s both}#ma-pl.is-quick .ma-pl-line>span{animation-duration:.7s}#ma-pl.is-quick .ma-pl-bar i{animation-duration:.7s;animation-delay:.05s}#ma-pl.is-in .ma-pl-line>span,#ma-pl.is-in .ma-pl-bar i{animation:none;opacity:1;transform:none}@keyframes maUp{from{transform:translateY(110%)}to{transform:none}}@keyframes maBar{from{transform:scaleX(0)}to{transform:scaleX(1)}}@media (prefers-reduced-motion:reduce){html.ma-pl::before,#ma-pl{display:none!important}html.ma-pl body{overflow:auto}}</style>\n<script>(function(){var d=document.documentElement;if(matchMedia(\"(prefers-reduced-motion: reduce)\").matches)return;\nvar first=true;try{first=!sessionStorage.getItem(\"maSeen\");sessionStorage.setItem(\"maSeen\",\"1\")}catch(e){}\nd.classList.add(\"ma-pl\");var t0=Date.now(),MIN=first?1700:950,MAX=first?3600:2400,el;\nvar HTML='<div class=\"ma-pl-inner\"><span class=\"ma-pl-line ma-pl-kick\"><span>מרכז למידה</span></span><span class=\"ma-pl-line ma-pl-name\"><span>מא\\' ועד ת\\'</span></span><span class=\"ma-pl-line ma-pl-role\"><span>הדר נזרית-ראובן · הוראה מתקנת בבאר שבע</span></span><span class=\"ma-pl-bar\"><i></i></span></div>';\nfunction mount(){if(el||!document.body)return!!el;el=document.createElement(\"div\");el.id=\"ma-pl\";el.setAttribute(\"aria-hidden\",\"true\");if(!first)el.className=\"is-quick\";el.innerHTML=HTML;document.body.insertBefore(el,document.body.firstChild);d.classList.add(\"ma-ready\");return true}\nif(!mount()){var mo=new MutationObserver(function(){if(mount())mo.disconnect()});mo.observe(d,{childList:true,subtree:true})}\nvar lifted=false;function lift(){if(lifted)return;lifted=true;setTimeout(function(){mount();el.classList.add(\"is-out\");d.classList.remove(\"ma-pl\");setTimeout(function(){el.classList.remove(\"is-out\");el.style.display=\"none\"},1200)},Math.max(0,MIN-(Date.now()-t0)))}\nif(document.readyState===\"complete\")lift();else addEventListener(\"load\",lift);setTimeout(lift,MAX);\ndocument.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"a[href]\");if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;\nif(a.target&&a.target!==\"_self\"||a.hasAttribute(\"download\"))return;var u=new URL(a.href,location.href);if(u.origin!==location.origin||!/\\.html$|\\/$/.test(u.pathname))return;\nif(u.pathname===location.pathname&&u.search===location.search)return;e.preventDefault();mount();el.style.display=\"\";el.className=\"is-in\";setTimeout(function(){location.href=u.href},560)});\naddEventListener(\"pageshow\",function(ev){if(ev.persisted&&el){el.className=\"\";el.style.display=\"none\";d.classList.remove(\"ma-pl\")}});})();</script>\n",
    "global_footer_custom": "<script>document.addEventListener(\"click\",function(e){if(e.target.closest&&e.target.closest(\".ma-panel a\")){var t=document.getElementById(\"maNavToggle\");if(t)t.checked=false}});document.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\"){var t=document.getElementById(\"maNavToggle\");if(t)t.checked=false}});</script>",
