          "_name": "form02",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form5\" group=\"Forms\" plugins=\"formstyler, datepicker\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#f8f4ee\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head mb-5\" mbr-if=\"showTitle || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>תשאירו פרטים</b>\n                    </h3>\n                    <h4 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                        ונחזור אליכם בהקדם לתיאום פגישה\n                    </h4>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"row justify-content-center\">\n            <div mbr-form class=\"col-lg-8 mx-auto mbr-form\">\n                <form action=\"hadar30484@walla.com\" name=\"Contact Form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                    <div class=\"row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">הפרטים נשלחו בהצלחה! נחזור אליכם בהקדם.</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">אופס... נראה שיש תקלה. נסו שוב מאוחר יותר.</div>\n                    </div>\n                    <div class=\"dragArea row\">\n                        <div class=\"col-md-6 form-group mb-3\" data-for=\"name\">\n                            <input type=\"text\" name=\"name\" placeholder=\"שם מלא\" data-form-field=\"name\" class=\"form-control\" mbr-theme-style=\"display-7\">\n                        </div>\n                        <div class=\"col-md-6 form-group mb-3\" data-for=\"email\">\n                            <input type=\"email\" name=\"email\" placeholder=\"אימייל\" data-form-field=\"email\" class=\"form-control\" mbr-theme-style=\"display-7\">\n                        </div>\n                        <div data-for=\"phone\" class=\"col-12 form-group mb-3\">\n                            <input type=\"tel\" name=\"phone\" placeholder=\"מספר טלפון\" data-form-field=\"phone\" class=\"form-control\" mbr-theme-style=\"display-7\">\n                        </div>\n                        <div data-for=\"textarea\" class=\"col-12 form-group mb-3\">\n                            <textarea name=\"textarea\" placeholder=\"איך אוכל לעזור?\" data-form-field=\"textarea\" class=\"form-control\" mbr-theme-style=\"display-7\"></textarea>\n                        </div>\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 align-center mbr-section-btn mt-3\">\n                            <button type=\"submit\" class=\"btn btn-primary display-7\">שלח הודעה</button>\n                        </div>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n</section>",
