              "font-size": "1.05rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-article\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wrap\">\n      <nav class=\"ma-crumbs\" aria-label=\"מיקום בעמוד\"><a href=\"index.html\">דף הבית</a><span aria-hidden=\"true\">/</span><a href=\"articles.html\">מאמרים</a></nav>\n      <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">הכנה לכיתה א'</span>\n      <h1 class=\"ma-art-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-art-title\"><strong>המעבר מגן חובה לכיתה א': איך נדע שהקטנטנים מגיעים מוכנים, רגועים ובטוחים?</strong></h1>\n      <p class=\"ma-lead mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-lead\">המעבר הזה הוא אחד השלבים המרגשים והמאתגרים בחיי הילד! מה זה בעצם \"מוכנות לכיתה א'\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה?</p>\n      <p class=\"ma-byline\" mbr-text data-app-selector=\".ma-byline\">מאת הדר נזרית-ראובן, מורה להוראה מתקנת · מרכז למידה מא-ת, באר שבע</p>\n      <figure class=\"ma-hero\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\"></figure>\n      <div class=\"ma-content\">\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">המעבר מהגן לבית הספר הוא הרבה יותר מהחלפת מבנה. בגן הילד משחק, זז בחופשיות ולומד מתוך התנסות. בכיתה א' הוא נדרש פתאום לשבת ליד שולחן, להקשיב לאורך זמן, לעקוב אחרי הוראות, לנהל ילקוט ולהתחיל לרכוש קריאה וכתיבה. רוב הילדים מסתגלים יפה, אבל ילד שמגיע מוכן חווה את השנה הראשונה בצורה אחרת לגמרי.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה בכלל \"מוכנות לכיתה א'\"?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">מוכנות היא לא רק \"לדעת אותיות\". היא משלבת כמה תחומים:</p>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות לימודית:</strong> היכרות עם האותיות והצלילים שלהן, יכולת לפרק מילה להברות ולצלילים ולהרכיב אותם בחזרה, זיהוי מספרים, ספירה והבנה בסיסית של כמות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות מוטורית:</strong> אחיזת עיפרון נכונה, גזירה, העתקה מהלוח ושליטה בתנועות הקטנות של היד.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קשב והתמדה:</strong> היכולת להישאר במשימה עד הסוף, גם כשהיא פחות מעניינת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות רגשית וחברתית:</strong> ביטחון עצמי, יכולת להתמודד עם תסכול, לבקש עזרה, לחכות לתור ולהשתלב בקבוצה.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>למה כדאי להתחיל לפני כיתה א'?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">ילד שמגיע לכיתה א' כשהוא כבר מכיר את האותיות ושולט בפירוק והרכבה של צלילים, לא צריך להתחיל את התהליך אחרי כולם. הוא יכול להתפנות לדברים החשובים באמת בתחילת הדרך: להכיר חברים, להתרגל למורה ולמסגרת, ולהרגיש שהוא מצליח. ההרגשה \"אני מצליח\" בחודשים הראשונים בונה את היחס של הילד ללמידה לשנים קדימה!</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">נכון, לגן יש תפקיד חשוב בהכנה. ונכון, יש ילדים שקולטים הכול לבד. אבל לא כל ילד מגיע עם אותו בסיס, ופערים קטנים בתחילת כיתה א' נוטים לגדול אם לא מבצעים מוכנות נכונה בזמן!</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>סימנים שכדאי לשים לב אליהם</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\">הילד מתקשה לזהות את הצליל הראשון במילה (\"באיזה צליל מתחילה המילה בית?\").</li>\n        <li mbr-text data-app-selector=\".ma-content li\">קשה לו לשבת כמה דקות ברצף מול משימה שולחנית.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא נמנע מציור, צביעה או כתיבה, או מחזיק את העיפרון בצורה לא נוחה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא נלחץ מאוד ממצבים חדשים או מוותר מהר כשמשהו לא מצליח.</li>\n      </ul>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">אף אחד מהסימנים האלה הוא לא סיבה לדאגה. הם פשוט מראים לנו על מה כדאי לחזק ולעבוד.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה אפשר לעשות בבית?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>משחקי צלילים:</strong> \"אני רואה משהו שמתחיל בצליל מ...\", חרוזים, מחיאות כפיים לכל הברה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה משותפת:</strong> לקרוא יחד כל ערב, לעצור ולשאול \"מה לדעתך יקרה עכשיו?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>חשבון ביום-יום:</strong> לספור מדרגות, להשוות כמויות בצלחת, לשחק משחקי קופסה וכמו כן גם משחקי קובייה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>עצמאות:</strong> לתת לילד לארגן תיק, להתלבש לבד ולסיים משימה קטנה עד הסוף.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לדבר על בית הספר בחיוב:</strong> לספר מה מחכה לו ולהימנע מהפחדות כמו \"בכיתה א' כבר לא משחקים\".</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך אנחנו עובדים במרכז מא-ת</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">במרכז למידה מא-ת בבאר שבע ההכנה לכיתה א' נעשית בקבוצות קטנות, דרך משחקים, חוויה והרבה הנאה. הדר נזרית-ראובן, מורה להוראה מתקנת עם תואר ראשון בחינוך מיוחד ו-15 שנות ניסיון, בונה לכל ילד תוכנית שמשלבת את הבסיס הלימודי (אותיות, צלילים, חשבון) יחד עם חיזוק הביטחון העצמי והמוכנות הרגשית.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">למשפחות שרוצות לתרגל גם בבית, יש את <strong>ערכת ההכנה לכיתה א'</strong> של המרכז: משחקים דידקטיים וחוברות פעילות בשפה ובחשבון, שמאפשרים לילד להתקדם בקצב שלו ובסביבה רגועה.</p>\n      </div>\n      <aside class=\"ma-cta\">\n        <h2 class=\"ma-cta-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-cta-title\"><strong>רוצים לבדוק אם הילד שלכם מוכן לכיתה א'?</strong></h2>\n        <p class=\"ma-cta-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-cta-text\">השאירו פרטים באתר או התקשרו ל-054-398-2557, ונשמח לייעץ.</p>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"tel:+972543982557\" data-app-placeholder=\"Type Text\">054-398-2557</a> <a class=\"btn btn-white-outline\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">השאירו פרטים</a></div>\n      </aside>\n      <div class=\"ma-related\">\n        <h2 class=\"ma-related-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-related-title\"><strong>מאמרים נוספים</strong></h2>\n        <div class=\"ma-related-grid\">\n        <a class=\"ma-related-card\" href=\"article-middle-school.html\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מיסודי לחטיבת ביניים</span></a>\n        <a class=\"ma-related-card\" href=\"article-reading-fluency.html\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">דיוק ושטף בקריאה ואסטרטגיות למידה</span></a>\n        </div>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary-outline\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_anchor": "ma-article-2c",
          "_isUserblock": true,
          "_cid": "vlvhkTp3SK",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "ma-footer",
          "_sourceTheme": "startm5",
          "_styles": {
