              "position": "absolute",
              "top": "calc(100% + 8px)",
              "right": "0",
              "min-width": "250px",
              "list-style": "none",
              "margin": "0",
              "padding": "10px",
              "background": "#ffffff",
              "border-radius": "18px",
              "box-shadow": "0 24px 50px -24px rgba(58, 52, 28, .45)",
              "border": "1px solid rgba(154, 130, 98, .15)",
