            },
            ".ma-content ul": {
              "margin": "0 0 1.4rem",
              "padding-right": "1.25rem",
              "padding-left": "0"
            },
            ".ma-content li": {
              "color": "#3f3a2c",
              "line-height": "1.8",
              "margin-bottom": ".5rem"
            },
            ".ma-content li::marker": {
              "color": "@mainColor"
            },
            ".ma-cta": {
              "margin-top": "3rem",
              "padding": "32px 28px",
