            },
            ".ma-links": {
              "display": "flex",
              "align-items": "center",
              "gap": "2px",
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-links li": {
              "position": "relative"
            },
            ".ma-link": {
              "display": "block",
              "padding": "9px 14px",
              "border-radius": "999px",
              "color": "@textColor !important",
              "font-weight": "500",
              "font-size": "1rem",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
            ".ma-link:hover, .ma-link:focus-visible": {
              "background": "rgba(183, 162, 132, .18)",
              "color": "@mainColor !important"
            },
            ".ma-has-sub > .ma-link::after": {
              "content": "''",
              "display": "inline-block",
              "width": "6px",
              "height": "6px",
              "margin-right": "8px",
              "border-left": "2px solid currentColor",
              "border-bottom": "2px solid currentColor",
              "transform": "translateY(-3px) rotate(-45deg)"
            },
            ".ma-sub": {
              "position": "absolute",
              "top": "calc(100% + 8px)",
              "right": "0",
              "min-width": "250px",
              "list-style": "none",
              "margin": "0",
              "padding": "10px",
              "background": "#ffffff",
              "border-radius": "18px",
              "box-shadow": "0 24px 50px -24px rgba(58, 52, 28, .45)",
              "border": "1px solid rgba(154, 130, 98, .15)",
              "opacity": "0",
              "visibility": "hidden",
              "transform": "translateY(6px)",
              "transition": "opacity .25s, transform .25s, visibility .25s"
            },
            ".ma-sub::before": {
              "content": "''",
              "position": "absolute",
              "top": "-10px",
              "right": "0",
              "left": "0",
              "height": "10px"
            },
            ".ma-has-sub:hover .ma-sub, .ma-has-sub:focus-within .ma-sub": {
