                "font-size": "1.15rem"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-whero\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#f8f4ee\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wh-grid\">\n      <div class=\"ma-wh-text\">\n        <span class=\"ma-kicker mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>הסדנאות של מרכז למידה מא-ת</span>\n        <h1 class=\"ma-wh-title mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-text><strong>סדנאות למידה לילדים בבאר שבע</strong></h1>\n        <p class=\"ma-wh-lead mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>מזמינה אתכם להתקדם בסדנאות השונות לפי תוכנית ממוקדת ומקצועית, בצורה הדרגתית ויסודית.</p>\n        <ul class=\"ma-facts\"><li>קבוצות קטנות</li><li>תוכנית אישית לכל תלמיד</li><li>מתנ\"ס הרוח היהודית, באר שבע</li></ul>\n        <div class=\"ma-btns\"><a class=\"ma-btn\" href=\"index.html#form02-9\">להשארת פרטים</a><a class=\"ma-btn-ghost\" href=\"https://wa.me/972543982557\" target=\"_blank\" rel=\"noopener\">כתבו לי בוואטסאפ</a></div>\n      </div>\n      <nav class=\"ma-wh-index\" aria-label=\"הסדנאות\">\n        <a class=\"ma-wh-card\" href=\"#timeline3-g\"><img src=\"@PROJECT_PATH@/assets/images/workshop-first-grade.jpg\" alt=\"הכנה לכיתה א'\" loading=\"lazy\"><span class=\"ma-wh-num\">01</span><span class=\"ma-wh-name\">הכנה לכיתה א'</span><span class=\"ma-wh-age\">לילדי גן חובה</span></a>\n        <a class=\"ma-wh-card\" href=\"#timeline3-y\"><img src=\"@PROJECT_PATH@/assets/images/workshop-math-language.jpg\" alt=\"מתמטיקה ושפה\" loading=\"lazy\"><span class=\"ma-wh-num\">02</span><span class=\"ma-wh-name\">מתמטיקה ושפה</span><span class=\"ma-wh-age\">לכיתות ב'-ו'</span></a>\n        <a class=\"ma-wh-card\" href=\"#timeline3-15\"><img src=\"@PROJECT_PATH@/assets/images/workshop-reading-fluency.jpg\" alt=\"דיוק ושטף בקריאה ובכתיבה\" loading=\"lazy\"><span class=\"ma-wh-num\">03</span><span class=\"ma-wh-name\">דיוק ושטף בקריאה ובכתיבה</span><span class=\"ma-wh-age\">לכיתות א'-ג'</span></a>\n      </nav>\n    </div>\n  </div>\n</section>",
