                  "padding-right": "32px",
                  "margin-bottom": "8px !important",
                  "color": "#ffffff",
                  "line-height": "1.2",
                  "&::before": {
                    "content": "\"✔\"",
                    "position": "absolute",
                    "right": "0",
                    "top": "50%",
                    "transform": "translateY(-50%)",
                    "color": "#b7a284",
                    "font-size": "1.2rem",
                    "font-weight": "900"
                  }
