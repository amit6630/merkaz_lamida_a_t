            },
            "@media (max-width: 991px)": {
              ".ma-wh-grid": {
                "grid-template-columns": "1fr"
              },
              ".ma-wh-lead": {
                "max-width": "none"
              }
            },
            "@media (max-width: 575px)": {
              ".ma-wh-card": {
                "grid-template-columns": "76px 1fr"
              },
              ".ma-wh-card img": {
                "width": "76px",
                "height": "76px"
