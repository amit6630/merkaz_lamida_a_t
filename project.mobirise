          "_name": "header01",
          "_sourceTheme": "guidem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 guidem5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-07-31-10.35.29-6d9394c0-600x450.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#000000\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-markup>\n                            <b>ברוכים הבאים</b><b><br></b>\n                            <div><b>למרכז למידה מא ועד ת</b></div>\n                        </h2>\n                    </div>\n\n                    <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"intro-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-markup><b>\n                            הדר נזרית-ראובן, בעלת 15 שנות ניסיון בהוראה מתקנת וחינוך מיוחד</b><br><b>\n                        </b></p>\n                        <ul class=\"list-items mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                            <li mbr-markup>תוכנית עבודה אישית לכל תלמיד לצמצום פערים משמעותיים</li>\n                            <li mbr-markup>חיזוק הביטחון העצמי, הקניית מיומנויות למידה והכנה רגשית</li>\n                            <li mbr-markup>מוכנות מלאה לכיתה א' וליווי תלמידי יסודי</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-primary\" href=\"index.html#people03-k\" data-app-placeholder=\"Type Text\">קראו עלינו</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vixbWeZwRc",
          "_anchor": "header01-26",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
