            },
            ".ma-cta-title": {
              "color": "#ffffff",
              "margin-bottom": ".5rem"
            },
            ".ma-cta-text": {
              "color": "#ffffff",
              "opacity": ".92",
              "margin-bottom": "0"
            },
            ".ma-cta .mbr-section-btn": {
              "margin-top": "1.25rem"
            },
            ".ma-cta .btn-white": {
              "color": "#3a341c !important"
            },
            ".ma-related": {
              "margin-top": "3.5rem"
            },
            ".ma-related-title": {
              "color": "@textColor",
              "margin-bottom": "1.25rem"
            },
            ".ma-related-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px"
            },
            "@media (min-width: 768px)": {
              ".ma-related-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            ".ma-related-card": {
              "display": "flex",
              "gap": "14px",
              "align-items": "center",
              "padding": "12px",
              "background": "#ffffff",
              "border-radius": "18px",
              "text-decoration": "none",
              "box-shadow": "0 12px 30px -22px rgba(58, 52, 28, .4)",
              "transition": "transform .3s ease"
            },
            ".ma-related-card:hover": {
              "transform": "translateY(-4px)"
            },
            ".ma-related-card img": {
              "width": "84px",
              "height": "84px",
              "object-fit": "cover",
              "border-radius": "14px",
              "flex": "none"
            },
            ".ma-related-card span": {
