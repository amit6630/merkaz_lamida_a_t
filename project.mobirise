              "text-align": "right"
            },
            ".mbr-section-title": {
              "margin-bottom": "36px",
              "color": "#b7a284",
              "text-align": "right"
            },
            ".icon_block": {
              "display": "inline-block",
              "position": "relative",
              ".mbr-iconfont": {
                "font-size": "150px",
                "position": "absolute",
                "top": "-10px",
                "left": "12px",
                "opacity": ".2",
                "color": "#ffffff"
              }
            },
            ".carousel-controls": {
              "margin-top": "30px",
              "width": "100%",
              "position": "relative",
              "height": "50px",
              "a": {
                "span": {
                  "width": "50px",
                  "height": "50px",
                  "line-height": "50px",
                  "font-weight": "700",
                  "font-size": "18px",
                  "position": "absolute",
                  "color": "@controlColor",
                  "background-color": "transparent",
                  "border-radius": "50%",
                  "border": "1px solid @controlColor",
                  "transition": "0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
                  "&:hover": {
                    "background-color": "@infoColor",
                    "color": "contrast(@infoColor)"
                  }
                }
              }
            },
            ".carousel-control-prev": {
              "position": "static",
              "margin-right": "10px",
              "width": "50px"
            },
            ".carousel-control-next": {
              "position": "static",
              "width": "50px"
            },
            ".show_md": {
              "display": "none"
            },
            ".user_text": {
              "margin-bottom": "40px",
              "text-align": "center",
              "color": "#000000",
              "min-height": "90px"
            },
            ".user_image": {
              "width": "80px",
              "height": "80px",
              "margin": "25px auto 35px auto",
              "position": "relative",
              "z-index": "1",
              "padding": "6px",
              "img": {
                "border-radius": "50%",
                "width": "80px",
                "height": "80px",
                "min-width": "100%",
                "min-height": "100%"
              },
              ".shape_1": {
                "position": "absolute",
                "z-index": "-1",
                "width": "80px",
                "height": "80px",
                "left": "10px",
                "top": "12px",
                "background-color": "fade(#ffffff, 30)",
                "border-radius": "50%"
              },
              ".shape_2": {
                "position": "absolute",
                "z-index": "-1",
                "width": "80px",
                "height": "80px",
                "right": "0",
                "top": "8px",
                "background-color": "fade(#ffffff, 30)",
                "border-radius": "50%"
              },
              ".shape_3": {
                "position": "absolute",
                "z-index": "-1",
                "width": "80px",
                "height": "80px",
                "right": "0",
                "top": "0px",
                "left": "7px",
                "background-color": "fade(#ffffff, 30)",
                "border-radius": "50%"
              }
            },
            ".user_name": {
              "margin-bottom": "15px",
              "line-height": "1.1",
              "font-weight": "600",
              "color": "#86704f"
            },
            ".user_prof": {
              "color": "#ffffff"
            },
            "@media (max-width: 991px)": {
              ".carousel-item": {
                "justify-content": "center"
              },
              ".figure_outline": {
                "margin-bottom": "0"
              },
              ".user": {
                "max-width": "400px"
              },
              ".icon_block": {
                ".mbr-iconfont": {
                  "font-size": "120px",
                  "top": "10px",
                  "left": "0"
                }
              },
              ".title_block": {
                "text-align": "center",
                "margin-top": "40px"
              },
              ".mbr-section-title": {
                "margin-bottom": "26px"
              },
              ".hide_md": {
                "display": "none"
              },
              ".show_md": {
                "display": "flex",
                "justify-content": "center",
                "margin-top": "105px"
              },
              "padding-top": "2rem",
              "padding-bottom": "3rem"
            },
            "@media (max-width: 767px)": {
              ".figure_outline, .icon_block": {
                "display": "none"
              },
              ".user_text": {
                "color": "inherit",
                "margin-bottom": "20px"
              },
              ".user_prof": {
                "color": "inherit"
              },
              ".user_name": {
                "color": "@secondaryColor",
                "margin-bottom": "5px"
              },
              ".show_md": {
                "display": "flex",
                "justify-content": "center",
                "margin-top": "25px"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-text": {
              "text-align": "right"
            },
            ".mbr-section-title P": {
              "text-align": "right"
            },
            "background-image": "linear-gradient(180deg, #ffffff 0, rgba(255, 255, 255, 0) 110px, rgba(255, 255, 255, 0) calc(100% - 110px), #ffffff 100%), url(\"data:image/svg+xml;base64,\")",
            "background-size": "auto, cover",
            "background-position": "center"
          },
          "_name": "testimonials2",
          "_sourceTheme": "firmm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"testimonials2 firmm4_testimonials2 carousel slide testimonials-slider\" group=\"Testimonials\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\" data-bs-interval=\"false\">\n\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" inline>\n        <input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" inline>\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"7\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n        <input type=\"checkbox\" title=\"Author\" name=\"showAuthor\" checked>\n        <input type=\"color\" title=\"Controls\" name=\"controlColor\" value=\"#6a7c92\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background.jpg\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f8f4ee\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-center justify-content-lg-between justify-content-center\">\n            <div class=\"col-xl-5 col-lg-6 col-md-12 col-12\">\n                <div class=\"figure_outline\">\n                    <div class=\"img\">\n                        <img class=\"img_1\" src=\"@PROJECT_PATH@/assets/images/testimonials-workshops.png\" alt=\"הורים מספרים על הסדנאות\">\n\n                    </div>\n                </div>\n                <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-bs-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" data-bs-interval=\"{{showAutoplay ? interval : 'false'}}\">\n                    <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner \">\n                        <div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>הדרי היקרה,<br>רציתי להודות לך על החוג המדהים שלך. שינון השתפר פלאים בקריאה, ואני רואה שיפור משמעותי.<br>הוא קורא יותר בבית, אפילו ספר פרשת שבוע בלי ניקוד!</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">יוסף</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>רציתי כבר לכתוב לך אתמול ולא הספקתי.<br>מה זאת ההשקעה הזאת?!?! את זן נדיר! חלומה של כל אמא וחלומו של כל ילד, מחנכת כמוך!! אני לא יודעת איפה את מלמדת ובאילו כיתות, אבל הם ללא ספק זכו בך!!</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">אירית</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    <div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>הדרוש, אחרי הסדנה מאיר השתנה. אני מרגישה שהוא עשה קפיצה וצמצם פער מאוד גדול שהיה לו.<br>אמנם קריאה היא לא הדבר האהוב עליו במיוחד, אבל הגענו לשלב שבערב שבת הוא משתדל מאוד להקריא לנו מתוך ספר דיסני.</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">\n                                            נועה</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div><div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>הדר, אני לא מאמינה! פה ושם אני מוצאת אותו יושב וקורא ספר לפני השינה, ואני בטוחה שיש קשר ישיר לחוג שאת מעבירה להם.<br>אלופה שאת, תודה רבה ❤❤</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">\n                                            איתי</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div><div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>הדרוש, חייבת לומר שזה פשוט מדהים איך שאת מצליחה להעביר לילדים את הלמידה בצורה כל כך חווייתית ונעימה.<br>תמר עפה על החוג, וכל שבוע מחכה לשיעור הבא בקוצר רוח.</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">\n                                            איתמר</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div><div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>הדרי, מקסים!!! אלופה!<br>עמית חוזר ממש מבסוט!!<br>איך שהגיע, אמר לי שהוא רוצה לעשות את השיעורים כדי לקבל 2 יהלומים 💎😃<br>אני אשב איתו ונשלח לך 💫</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">נועה</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div><div class=\"carousel-item text-left\">\n                            <div class=\"user w-100\">\n                                <div class=\"icon_block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mobi-mbri-quote-left mobi-mbri\"></span>\n                                </div>\n                                <div class=\"user_image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/testimonial-avatar.jpg\" alt=\"\">\n                                    <div class=\"shape_1\"></div>\n                                    <div class=\"shape_2\"></div>\n                                    <div class=\"shape_3\"></div>\n                                </div>\n                                <p class=\"user_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text\"><b>אופיר מאוד מרוצה, ואני בעצמי מאוד מרוצה.<br>תודה רבה על הכול 🤩 אתן מהממות, והוא מאוד נהנה. זה שווה הכול.</b></p>\n                                <div class=\"author text-center\" mbr-if=\"showAuthor\">\n                                        <div mbr-text class=\"user_name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name\">\n                                            נועם</div>\n                                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_prof\"></div>\n                                </div>\n                            </div>\n                        </div></div>\n                </div>\n            </div>\n            <div class=\"col-xl-6 col-lg-5 col-md-8 col-sm-8 col-12\">\n                <div class=\"carousel-controls show_md\">\n                    <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                        <span aria-hidden=\"true\" class=\"mobi-mbri-left mobi-mbri mbr-iconfont\"></span>\n                        <span class=\"sr-only visually-hidden\">Previous</span>\n                    </a>\n\n                    <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                        <span aria-hidden=\"true\" class=\"mobi-mbri-right mobi-mbri mbr-iconfont\"></span>\n                        <span class=\"sr-only visually-hidden\">Next</span>\n                    </a>\n                </div>\n                <div class=\"title_block\">\n                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-subtitle\">הורים מספרים</h4>\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>לקוחות ממליצים</b></h3>\n                    <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"></p>\n                </div>\n                <div class=\"carousel-controls hide_md\">\n                    <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                        <span aria-hidden=\"true\" class=\"mobi-mbri-left mobi-mbri mbr-iconfont\"></span>\n                        <span class=\"sr-only visually-hidden\">Previous</span>\n                    </a>\n\n                    <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                        <span aria-hidden=\"true\" class=\"mobi-mbri-right mobi-mbri mbr-iconfont\"></span>\n                        <span class=\"sr-only visually-hidden\">Next</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "testimonials2-1v",
          "_isUserblock": true,
          "_cid": "u9mh6moFT4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "ma-wcta",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "direction": "rtl",
            "color": "@textColor",
            ".ma-cta-box": {
              "padding": "clamp(32px, 5vw, 56px)",
              "border-radius": "32px",
              "text-align": "center",
              "color": "#f8f4ee",
              "background": "radial-gradient(600px 300px at 85% 0%, rgba(241, 223, 186, .25), transparent 70%), linear-gradient(140deg, #3a341c, #8a7458)",
              "box-shadow": "0 30px 60px -34px rgba(58, 52, 28, .7)"
            },
            ".ma-cta-t": {
              "color": "#f8f4ee",
              "margin-bottom": ".8rem"
            },
            ".ma-cta-p": {
              "color": "rgba(248, 244, 238, .85)",
              "margin": "0 auto",
              "max-width": "46ch"
            },
            ".ma-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "12px",
              "margin-top": "1.6rem"
            },
            ".ma-btn-w": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "13px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "text-decoration": "none !important",
              "transition": "transform .25s, box-shadow .25s",
              "background": "#f8f4ee",
              "color": "#3a341c !important"
            },
            ".ma-btn-o": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "13px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "text-decoration": "none !important",
              "transition": "transform .25s, box-shadow .25s",
              "border": "1px solid rgba(248, 244, 238, .45)",
              "color": "#f8f4ee !important"
            },
            ".ma-btn-w:hover, .ma-btn-o:hover": {
              "transform": "translateY(-2px)"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-wcta\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-cta-box\">\n      <h2 class=\"ma-cta-t mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text><strong>לא בטוחים איזו סדנה מתאימה?</strong></h2>\n      <p class=\"ma-cta-p mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>השאירו פרטים או כתבו לי, ונבנה יחד את הדרך המתאימה לילד שלכם.</p>\n      <div class=\"ma-btns\"><a class=\"ma-btn-w\" href=\"index.html#form02-9\">להשארת פרטים</a><a class=\"ma-btn-o\" href=\"https://wa.me/972543982557\" target=\"_blank\" rel=\"noopener\">וואטסאפ</a><a class=\"ma-btn-o\" href=\"tel:+972543982557\">054-398-2557</a></div>\n    </div>\n  </div>\n</section>",
