              "background": "rgba(183, 162, 132, .18)",
              "color": "#7a6648",
              "border-radius": "999px",
              "padding": "4px 14px",
              "font-size": ".95rem",
              "font-weight": "700",
              "margin-bottom": "1rem"
            },
            ".ma-art-title": {
              "color": "@textColor",
              "margin-bottom": "1rem",
              "line-height": "1.2"
            },
            ".ma-lead": {
              "color": "#5b5446",
              "margin-bottom": "1rem",
              "line-height": "1.6"
            },
            ".ma-byline": {
              "color": "#8a8170",
              "font-size": "1rem",
              "margin": "0"
            },
            ".ma-hero": {
              "margin": "2.5rem 0",
              "border-radius": "26px",
              "overflow": "hidden",
              "box-shadow": "0 24px 50px -28px rgba(58, 52, 28, .45)"
            },
            ".ma-hero img": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-height": "520px",
              "object-fit": "cover",
              "border-radius": "0"
            },
            ".ma-content h2": {
              "color": "@textColor",
              "margin": "2.5rem 0 1rem",
              "padding-right": "14px",
              "border-right": "4px solid @mainColor"
            },
            ".ma-content p": {
              "color": "#3f3a2c",
              "line-height": "1.85",
              "margin-bottom": "1.1rem"
            },
            ".ma-content ul": {
              "margin": "0 0 1.4rem",
              "padding-right": "1.25rem",
              "padding-left": "0"
            },
            ".ma-content li": {
              "color": "#3f3a2c",
              "line-height": "1.8",
              "margin-bottom": ".5rem"
            },
            ".ma-content li::marker": {
              "color": "@mainColor"
            },
            ".ma-cta": {
              "margin-top": "3rem",
              "padding": "32px 28px",
              "border-radius": "24px",
              "background": "@mainColor",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".ma-cta-title": {
              "color": "#ffffff",
              "margin-bottom": ".5rem"
            },
            ".ma-cta-text": {
              "color": "#ffffff",
              "opacity": ".92",
              "margin-bottom": "0"
            },
            ".ma-cta .mbr-section-btn": {
              "margin-top": "1.25rem"
            },
            ".ma-cta .btn-white": {
              "color": "#3a341c !important"
            },
            ".ma-related": {
              "margin-top": "3.5rem"
            },
            ".ma-related-title": {
              "color": "@textColor",
              "margin-bottom": "1.25rem"
            },
            ".ma-related-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px"
            },
            "@media (min-width: 768px)": {
              ".ma-related-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            ".ma-related-card": {
              "display": "flex",
              "gap": "14px",
              "align-items": "center",
              "padding": "12px",
              "background": "#ffffff",
              "border-radius": "18px",
              "text-decoration": "none",
              "box-shadow": "0 12px 30px -22px rgba(58, 52, 28, .4)",
              "transition": "transform .3s ease"
            },
            ".ma-related-card:hover": {
              "transform": "translateY(-4px)"
            },
            ".ma-related-card img": {
              "width": "84px",
              "height": "84px",
              "object-fit": "cover",
              "border-radius": "14px",
              "flex": "none"
            },
            ".ma-related-card span": {
              "color": "@textColor",
              "font-weight": "700",
              "line-height": "1.4",
              "font-size": "1.05rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-article\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wrap\">\n      <nav class=\"ma-crumbs\" aria-label=\"מיקום בעמוד\"><a href=\"index.html\">דף הבית</a><span aria-hidden=\"true\">/</span><a href=\"articles.html\">מאמרים</a></nav>\n      <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">מעבר לחטיבה</span>\n      <h1 class=\"ma-art-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-art-title\"><strong>המעבר מיסודי לחטיבת ביניים: איך מכינים את הילד לקפיצת המדרגה?</strong></h1>\n      <p class=\"ma-lead mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-lead\">המעבר מכיתה ו' לחטיבת הביניים מביא איתו יותר מקצועות, יותר מורים ויותר עצמאות. מה משתנה, אילו מיומנויות כדאי לחזק בכיתות ה'-ו', ואיך הורים יכולים לעזור.</p>\n      <p class=\"ma-byline\" mbr-text data-app-selector=\".ma-byline\">מאת הדר נזרית-ראובן, מורה להוראה מתקנת · מרכז למידה מא-ת, באר שבע</p>\n      <figure class=\"ma-hero\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\"></figure>\n      <div class=\"ma-content\">\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">המעבר לחטיבת הביניים מגיע בדיוק בגיל שבו הרבה דברים משתנים בבת אחת: הגוף, החברים, הרצון בעצמאות. ובמקביל, המסגרת הלימודית משתנה כמעט לגמרי. ילד שהיה רגיל למחנכת אחת שמכירה אותו היטב, פוגש פתאום מורה אחר בכל שיעור, מערכת שעות עמוסה ודרישות חדשות.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה משתנה בחטיבת הביניים?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>יותר מקצועות ויותר מורים:</strong> כל מורה מלמד את המקצוע שלו ומכיר פחות את התמונה המלאה של הילד.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>יותר עצמאות:</strong> התלמיד צריך לנהל לבד שיעורי בית, מבחנים, עבודות ומועדי הגשה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>טקסטים ארוכים ומורכבים יותר:</strong> בכל המקצועות, לא רק בלשון, נדרשת הבנת הנקרא ברמה גבוהה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מתמטיקה מופשטת יותר:</strong> חשבון בסיסי הופך לאלגברה, משוואות ובעיות מילוליות מורכבות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>שינוי חברתי:</strong> כיתה חדשה, חברים חדשים ולפעמים גם בית ספר חדש.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>אילו מיומנויות כדאי לחזק כבר ביסודי?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\"><strong>1. הבנת הנקרא.</strong> תלמיד שמבין טקסט לעומק ויודע לזהות רעיון מרכזי, לסכם ולענות על שאלות פתוחות, יתמודד טוב יותר בכל המקצועות.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\"><strong>2. כתיבה מסודרת.</strong> בחטיבה נדרשת כתיבה של תשובות מנומקות, סיכומים ועבודות. שליטה בכללי הכתיבה, בדקדוק ובאוצר מילים עשיר עושה כאן הבדל גדול.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\"><strong>3. בסיס חשבוני יציב.</strong> פערים בשברים, באחוזים או בלוח הכפל לא נעלמים בחטיבה, הם רק נעשים כבדים יותר. זה הזמן לצמצם אותם ככל הניתן.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\"><strong>4. אסטרטגיות למידה נכונות.</strong> איך מתכוננים למבחן? איך מחלקים חומר גדול לחלקים? איך מסכמים ואיך בודקים שבאמת הבנתי?</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\"><strong>5. ניהול זמן וארגון.</strong> יומן, רשימת משימות, תיק מסודר והרגל לבדוק מה צריך להגיש מחר, ועוד.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך הורים יכולים לעזור?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לדבר על המעבר מראש:</strong> לשאול ממה הילד מתרגש וממה הוא חושש, ולהקשיב בלי למהר לפתור.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לבנות עצמאות בהדרגה:</strong> כבר בכיתה ו' לתת לילד אחריות על הכנת שיעורי הבית ועל התיק, ולהישאר ברקע כתמיכה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לשים לב לפערים:</strong> אם הילד מתקשה במקצוע מסוים כבר עכשיו, עדיף לחזק אותו לפני המעבר ולא אחריו.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לשמור על ביטחון עצמי:</strong> לחגוג הצלחות קטנות ולהזכיר לילד שקשיים בתחילת הדרך הם חלק טבעי מהתהליך.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך המרכז מא-ת יכול לעזור</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">במרכז למידה מא-ת אנחנו מלווים תלמידי כיתות ב'-ו' במתמטיקה ובשפה, בקבוצות קטנות ובתוכנית אישית. עבור תלמידי הכיתות הגבוהות של היסודי, זה בדיוק הזמן לבנות את הבסיס לחטיבה: לסגור פערים, לחזק את הבנת הנקרא והכתיבה, ולהקנות כלים ללמידה עצמאית ולפתרון בעיות.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">המטרה שלנו היא שהילד יגיע לחטיבת הביניים עם ידע, עם הרגלי למידה טובים ובעיקר עם תחושה של \"אני מסוגל\".</p>\n      </div>\n      <aside class=\"ma-cta\">\n        <h2 class=\"ma-cta-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-cta-title\"><strong>רוצים להתייעץ לקראת המעבר?</strong></h2>\n        <p class=\"ma-cta-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-cta-text\">השאירו פרטים באתר או התקשרו ל-054-398-2557.</p>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"tel:+972543982557\" data-app-placeholder=\"Type Text\">054-398-2557</a> <a class=\"btn btn-white-outline\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">השאירו פרטים</a></div>\n      </aside>\n      <div class=\"ma-related\">\n        <h2 class=\"ma-related-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-related-title\"><strong>מאמרים נוספים</strong></h2>\n        <div class=\"ma-related-grid\">\n        <a class=\"ma-related-card\" href=\"article-first-grade.html\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מגן חובה לכיתה א'</span></a>\n        <a class=\"ma-related-card\" href=\"article-reading-fluency.html\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">דיוק ושטף בקריאה ואסטרטגיות למידה</span></a>\n        </div>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary-outline\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_anchor": "ma-article-2e",
          "_isUserblock": true,
          "_cid": "vau5kHvRwM",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "ma-footer",
