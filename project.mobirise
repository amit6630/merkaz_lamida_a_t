        "header_custom": "<!-- seo -->\n<meta name=\"theme-color\" content=\"#9a8262\">\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/card.html\">\n<meta property=\"og:type\" content=\"profile\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/card.html\">\n<meta property=\"og:title\" content=\"כרטיס ביקור דיגיטלי | הדר נזרית-ראובן, מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"כרטיס הביקור הדיגיטלי של הדר נזרית-ראובן, מורה להוראה מתקנת במרכז למידה מא-ת בבאר שבע. חיוג, וואטסאפ, ניווט ושמירת איש קשר בלחיצה.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/logo-card.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"ProfilePage\",\n  \"url\": \"https://merkaz-lamida-a-t.com/card.html\",\n  \"inLanguage\": \"he\",\n  \"mainEntity\": {\n    \"@type\": \"Person\",\n    \"name\": \"הדר נזרית-ראובן\",\n    \"jobTitle\": \"מורה להוראה מתקנת\",\n    \"telephone\": \"+972-54-398-2557\",\n    \"email\": \"hadar30484@walla.com\",\n    \"image\": \"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\",\n    \"worksFor\": {\n      \"@type\": \"EducationalOrganization\",\n      \"name\": \"מרכז למידה מא-ת\",\n      \"url\": \"https://merkaz-lamida-a-t.com/\"\n    },\n    \"sameAs\": [\n      \"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/\",\n      \"https://www.instagram.com/merkaz_lemida_a_t/\"\n    ]\n  }\n}\n</script>",
