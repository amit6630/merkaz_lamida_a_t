            ".ma-fwrap": {
              "max-width": "1200px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 40px)"
            },
            ".ma-fgrid": {
              "display": "grid",
              "grid-template-columns": "1.4fr 1fr 1fr 1.2fr",
              "gap": "36px"
            },
            ".ma-flogo img": {
              "width": "170px",
              "height": "auto",
              "border-radius": "18px !important",
              "padding": "10px",
              "background": "#f8f4ee"
            },
            ".ma-ftext": {
              "margin": "16px 0",
              "line-height": "1.7",
              "font-size": ".98rem",
              "max-width": "32ch"
            },
            ".ma-fsocial": {
              "display": "flex",
              "gap": "10px"
            },
            ".ma-fsocial a": {
              "width": "42px",
              "height": "42px",
              "border-radius": "50%",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid rgba(248, 244, 238, .22)",
              "color": "#f8f4ee !important",
              "text-decoration": "none !important",
              "transition": "background .25s"
            },
            ".ma-fsocial a:hover": {
              "background": "@accentColor"
            },
            ".ma-fhead": {
              "color": "#f8f4ee",
              "font-size": "1.1rem",
              "font-weight": "600",
              "margin": "6px 0 14px"
            },
            ".ma-fcol ul": {
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-fcol li": {
              "margin-bottom": "9px"
            },
            ".ma-fcol a, .ma-fcol span": {
              "color": "rgba(248, 244, 238, .78) !important",
              "text-decoration": "none !important",
              "font-size": ".98rem"
            },
            ".ma-fcol a:hover": {
              "color": "@accentColor !important"
            },
            ".ma-fcta": {
              "display": "inline-block",
              "margin-top": "8px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "background": "@accentColor",
              "color": "#2f2a18 !important",
              "font-weight": "600",
              "font-size": ".98rem"
            },
            ".ma-fbottom": {
