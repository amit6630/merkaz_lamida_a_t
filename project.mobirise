    "article-reading-fluency.html": {
      "settings": {
        "title": "דיוק ושטף בקריאה ואסטרטגיות למידה | מרכז למידה מא-ת",
        "order": "5",
        "meta_descr": "מה ההבדל בין דיוק לשטף בקריאה, למה שניהם חשובים להבנת הנקרא, ואילו אסטרטגיות למידה עוזרות לילדים להצליח בשפה ובחשבון.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/article-reading-fluency.html\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/article-reading-fluency.html\">\n<meta property=\"og:title\" content=\"דיוק ושטף בקריאה ואסטרטגיות למידה | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"מה ההבדל בין דיוק לשטף בקריאה, למה שניהם חשובים להבנת הנקרא, ואילו אסטרטגיות למידה עוזרות לילדים להצליח בשפה ובחשבון.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/service-reading-fluency.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Article\",\n      \"headline\": \"דיוק ושטף בקריאה, ואסטרטגיות למידה בשפה ובחשבון\",\n      \"description\": \"מה ההבדל בין דיוק לשטף בקריאה, למה שניהם חשובים להבנת הנקרא, ואילו אסטרטגיות למידה עוזרות לילדים להצליח בשפה ובחשבון.\",\n      \"inLanguage\": \"he\",\n      \"url\": \"https://merkaz-lamida-a-t.com/article-reading-fluency.html\",\n      \"mainEntityOfPage\": \"https://merkaz-lamida-a-t.com/article-reading-fluency.html\",\n      \"image\": \"https://merkaz-lamida-a-t.com/assets/images/service-reading-fluency.jpg\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"הדר נזרית-ראובן\",\n        \"jobTitle\": \"מורה להוראה מתקנת\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\"\n        }\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"דף הבית\",\n          \"item\": \"https://merkaz-lamida-a-t.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"מאמרים\",\n          \"item\": \"https://merkaz-lamida-a-t.com/articles.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": \"דיוק ושטף בקריאה ואסטרטגיות למידה\",\n          \"item\": \"https://merkaz-lamida-a-t.com/article-reading-fluency.html\"\n        }\n      ]\n    }\n  ]\n}\n</script>",
