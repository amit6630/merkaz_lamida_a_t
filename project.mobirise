        {
          "_name": "ma-ws",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "direction": "rtl",
            "color": "@textColor",
            ".ma-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "12px",
              "margin-top": "1.6rem"
            },
            ".ma-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "13px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "text-decoration": "none !important",
              "transition": "transform .25s, box-shadow .25s",
              "color": "#ffffff !important",
              "background": "linear-gradient(120deg, #8a7458, #b7a284)",
              "box-shadow": "0 14px 26px -16px rgba(58, 52, 28, .75)"
            },
            ".ma-btn:hover": {
              "transform": "translateY(-2px)"
            },
            ".ma-btn-ghost": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "13px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "text-decoration": "none !important",
              "transition": "transform .25s, box-shadow .25s",
              "color": "@textColor !important",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .35)"
            },
            ".ma-btn-ghost:hover": {
              "border-color": "@mainColor",
              "transform": "translateY(-2px)"
            },
            ".ma-ws-grid": {
              "display": "grid",
              "grid-template-columns": "0.9fr 1.1fr",
              "gap": "clamp(28px, 5vw, 72px)",
              "align-items": "start"
            },
            ".ma-ws-grid.is-rev": {
              "grid-template-columns": "1.1fr 0.9fr"
            },
            ".ma-ws-grid.is-rev .ma-ws-media": {
              "order": "2"
            },
            ".ma-ws-media": {
              "position": "sticky",
              "top": "110px",
              "margin": "0"
            },
            ".ma-ws-media img": {
              "width": "100%",
              "aspect-ratio": "4 / 5",
              "max-height": "620px",
              "object-fit": "cover",
              "border-radius": "28px !important",
              "box-shadow": "0 30px 60px -34px rgba(58, 52, 28, .6)"
            },
            ".ma-ws-badge": {
              "position": "absolute",
              "bottom": "18px",
              "right": "18px",
              "padding": "9px 16px",
              "border-radius": "999px",
              "background": "rgba(255, 255, 255, .92)",
              "color": "@textColor",
              "font-weight": "600",
              "font-size": ".95rem",
              "box-shadow": "0 10px 24px -14px rgba(0, 0, 0, .45)"
            },
            ".ma-kicker": {
              "display": "inline-block",
              "color": "@mainColor",
              "font-weight": "700",
              "letter-spacing": ".05em",
              "margin-bottom": ".7rem"
            },
            ".ma-ws-title": {
              "color": "@textColor",
              "line-height": "1.1",
              "margin-bottom": "1rem"
            },
            ".ma-ws-lead": {
              "font-size": "1.2rem",
              "line-height": "1.65",
              "color": "@textColor",
              "font-weight": "500",
              "margin-bottom": "1.1rem"
            },
            ".ma-ws-text p": {
              "color": "#4a4434",
              "line-height": "1.8",
              "margin-bottom": "1rem"
            },
            ".ma-ws-h3": {
              "color": "@textColor",
              "font-size": "1.15rem",
              "margin": "1.4rem 0 .8rem"
            },
            ".ma-checks": {
              "list-style": "none",
              "margin": "0 0 .4rem",
              "padding": "0",
              "display": "grid",
              "gap": "10px"
            },
            ".ma-checks li": {
              "position": "relative",
              "padding-right": "34px",
              "line-height": "1.6",
              "color": "#3f3a2c"
            },
            ".ma-checks li::before": {
              "content": "'✓'",
              "position": "absolute",
              "right": "0",
              "top": "1px",
              "width": "24px",
              "height": "24px",
              "border-radius": "50%",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "rgba(183, 162, 132, .22)",
              "color": "#7a6648",
              "font-size": ".8rem",
              "font-weight": "700"
            },
            ".ma-pills": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px",
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-pills li": {
              "padding": "8px 16px",
              "border-radius": "999px",
              "background": "#f8f4ee",
              "border": "1px solid rgba(154, 130, 98, .25)",
              "font-weight": "500"
            },
            ".ma-note": {
              "margin": "1.2rem 0",
              "padding": "16px 20px",
              "border-radius": "18px",
              "background": "rgba(183, 162, 132, .14)",
              "border-right": "4px solid @mainColor"
            },
            ".ma-note p": {
              "margin": "0 !important"
            },
            ".ma-cols": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "16px"
            },
            ".ma-col": {
              "padding": "20px 22px",
              "border-radius": "20px",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .16)",
              "box-shadow": "0 16px 32px -28px rgba(58, 52, 28, .5)"
            },
            ".ma-col-t": {
              "font-family": "'Fredoka', sans-serif",
              "font-weight": "600",
              "font-size": "1.2rem",
              "color": "@mainColor",
              "margin": "0 0 .7rem"
            },
            ".ma-dots": {
              "list-style": "none",
              "margin": "0",
              "padding": "0",
              "display": "grid",
              "gap": "8px"
            },
            ".ma-dots li": {
              "position": "relative",
              "padding-right": "18px",
              "line-height": "1.6",
              "color": "#3f3a2c",
              "font-size": ".98rem"
            },
            ".ma-dots li::before": {
              "content": "''",
              "position": "absolute",
              "right": "0",
              "top": ".6em",
              "width": "7px",
              "height": "7px",
              "border-radius": "50%",
              "background": "@mainColor"
            },
            ".ma-groups": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "12px",
              "margin-bottom": "1rem"
            },
            ".ma-group": {
              "display": "grid",
              "gap": "4px",
              "padding": "18px 20px",
              "border-radius": "18px",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .2)"
            },
            ".ma-group-t": {
              "font-weight": "600",
              "color": "@textColor"
            },
            ".ma-group-s": {
              "color": "@mainColor",
              "font-size": ".95rem"
            },
            ".ma-place": {
              "display": "inline-block",
              "padding": "8px 16px",
              "border-radius": "999px",
              "background": "#f8f4ee",
              "font-size": ".98rem"
            },
            "@media (max-width: 991px)": {
              ".ma-ws-grid, .ma-ws-grid.is-rev": {
                "grid-template-columns": "1fr"
              },
              ".ma-ws-grid.is-rev .ma-ws-media": {
                "order": "0"
              },
              ".ma-ws-media": {
                "position": "relative",
                "top": "0"
              },
              ".ma-ws-media img": {
                "aspect-ratio": "16 / 10",
                "max-height": "340px"
              }
            },
            "@media (max-width: 575px)": {
              ".ma-cols, .ma-groups": {
                "grid-template-columns": "1fr"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-ws\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-ws-grid\">\n      <figure class=\"ma-ws-media\"><img src=\"@PROJECT_PATH@/assets/images/workshop-first-grade.jpg\" alt=\"סדנת הכנה לכיתה א'\" loading=\"lazy\"><figcaption class=\"ma-ws-badge\">לילדי גן חובה</figcaption></figure>\n      <div class=\"ma-ws-text\">\n        <span class=\"ma-kicker mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>סדנה 01 · לילדי גן חובה</span>\n        <h2 class=\"ma-ws-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text><strong>הכנה לכיתה א'</strong></h2>\n        <p class=\"ma-ws-lead mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>מוכנים לכיתה א'? זה אחד הדברים החשובים ביותר שאפשר להעניק לילד. ילד מוכן, בשל ומבין יכול להכיל את תהליך רכישת הקריאה בקלות ובהנאה.</p>\n        <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>אחד הפלוסים שאפשר להעניק לילד הוא האפשרות להיכנס לכיתה א' ולעסוק בעניינים חברתיים ורגשיים, בלי לדאוג לרכישת הקריאה והכתיבה.</p>\n        <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text>נכון, לגן יש תפקיד ואחריות, ויש ילדים שיודעים, קולטים ומבינים בעצמם. אבל ילד שמגיע כשהוא מכיר את האותיות ושולט בפירוק והרכבה של צלילים, יכול להתחיל לקרוא ולכתוב בקלות, ולא צריך להתחיל את התהליך אחרי כולם.</p>\n        <div class=\"ma-note\"><p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text><strong>שימו לב!</strong> אנחנו בתקופה של למידה לא רציפה, שבה נצברים פערים משמעותיים שחייבים להשלים. הילד שלכם מוכן? מצוין. לא מוכן? עכשיו זה הזמן להתחיל!</p></div>\n        <h3 class=\"ma-ws-h3 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text><strong>איך?</strong></h3>\n        <ul class=\"ma-pills mbr-fonts-style\" mbr-theme-style=\"display-7\"><li mbr-text>משחקים</li><li mbr-text>חוויה</li><li mbr-text>הנאה</li><li mbr-text>למידה</li><li mbr-text>הרבה כיף יחד</li></ul>\n        <div class=\"ma-btns\"><a class=\"ma-btn\" href=\"index.html#form02-9\">שלחו הודעה עכשיו</a><a class=\"ma-btn-ghost\" href=\"tel:+972543982557\">054-398-2557</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_anchor": "timeline3-g",
          "_isUserblock": true,
          "_cid": "v1lw36SQLY",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
