        },
        {
          "_name": "ma-article",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "direction": "rtl",
            "color": "@textColor",
            ".ma-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".ma-crumbs": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px",
              "font-size": "1rem",
              "color": "#8a8170",
              "margin-bottom": "1.5rem"
            },
            ".ma-crumbs a": {
              "color": "@mainColor",
              "text-decoration": "none"
            },
            ".ma-crumbs a:hover": {
              "text-decoration": "underline"
            },
            ".ma-tag": {
              "display": "inline-block",
              "background": "rgba(183, 162, 132, .18)",
              "color": "#7a6648",
              "border-radius": "999px",
              "padding": "4px 14px",
              "font-size": ".95rem",
              "font-weight": "700",
              "margin-bottom": "1rem"
            },
            ".ma-art-title": {
              "color": "@textColor",
              "margin-bottom": "1rem",
              "line-height": "1.2"
            },
            ".ma-lead": {
              "color": "#5b5446",
              "margin-bottom": "1rem",
              "line-height": "1.6"
            },
            ".ma-byline": {
              "color": "#8a8170",
              "font-size": "1rem",
              "margin": "0"
            },
            ".ma-hero": {
              "margin": "2.5rem 0",
              "border-radius": "26px",
              "overflow": "hidden",
              "box-shadow": "0 24px 50px -28px rgba(58, 52, 28, .45)"
            },
            ".ma-hero img": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-height": "520px",
              "object-fit": "cover",
              "border-radius": "0"
            },
            ".ma-content h2": {
              "color": "@textColor",
              "margin": "2.5rem 0 1rem",
              "padding-right": "14px",
              "border-right": "4px solid @mainColor"
            },
            ".ma-content p": {
              "color": "#3f3a2c",
              "line-height": "1.85",
              "margin-bottom": "1.1rem"
            },
            ".ma-content ul": {
              "margin": "0 0 1.4rem",
              "padding-right": "1.25rem",
              "padding-left": "0"
            },
            ".ma-content li": {
              "color": "#3f3a2c",
              "line-height": "1.8",
              "margin-bottom": ".5rem"
            },
            ".ma-content li::marker": {
              "color": "@mainColor"
            },
            ".ma-cta": {
              "margin-top": "3rem",
              "padding": "32px 28px",
              "border-radius": "24px",
              "background": "@mainColor",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".ma-cta-title": {
              "color": "#ffffff",
              "margin-bottom": ".5rem"
            },
            ".ma-cta-text": {
              "color": "#ffffff",
              "opacity": ".92",
              "margin-bottom": "0"
            },
            ".ma-cta .mbr-section-btn": {
              "margin-top": "1.25rem"
            },
            ".ma-cta .btn-white": {
              "color": "#3a341c !important"
            },
            ".ma-related": {
              "margin-top": "3.5rem"
            },
            ".ma-related-title": {
              "color": "@textColor",
              "margin-bottom": "1.25rem"
            },
            ".ma-related-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px"
            },
            "@media (min-width: 768px)": {
              ".ma-related-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            ".ma-related-card": {
              "display": "flex",
              "gap": "14px",
              "align-items": "center",
              "padding": "12px",
              "background": "#ffffff",
              "border-radius": "18px",
              "text-decoration": "none",
              "box-shadow": "0 12px 30px -22px rgba(58, 52, 28, .4)",
              "transition": "transform .3s ease"
            },
            ".ma-related-card:hover": {
              "transform": "translateY(-4px)"
            },
            ".ma-related-card img": {
              "width": "84px",
              "height": "84px",
              "object-fit": "cover",
              "border-radius": "14px",
              "flex": "none"
            },
            ".ma-related-card span": {
              "color": "@textColor",
              "font-weight": "700",
              "line-height": "1.4",
              "font-size": "1.05rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-article\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wrap\">\n      <nav class=\"ma-crumbs\" aria-label=\"מיקום בעמוד\"><a href=\"index.html\">דף הבית</a><span aria-hidden=\"true\">/</span><a href=\"articles.html\">מאמרים</a></nav>\n      <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">הכנה לכיתה א'</span>\n      <h1 class=\"ma-art-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-art-title\"><strong>המעבר מגן חובה לכיתה א': איך מגיעים מוכנים, רגועים ובטוחים</strong></h1>\n      <p class=\"ma-lead mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-lead\">המעבר מגן חובה לכיתה א' הוא אחד השלבים המרגשים והמאתגרים בחיי הילד. מה זה בעצם \"מוכנות לכיתה א'\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה.</p>\n      <p class=\"ma-byline\" mbr-text data-app-selector=\".ma-byline\">מאת הדר נזרית-ראובן, מורה להוראה מתקנת · מרכז למידה מא-ת, באר שבע</p>\n      <figure class=\"ma-hero\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\"></figure>\n      <div class=\"ma-content\">\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">המעבר מהגן לבית הספר הוא הרבה יותר מהחלפת מבנה. בגן הילד משחק, זז בחופשיות ולומד מתוך התנסות. בכיתה א' הוא נדרש פתאום לשבת ליד שולחן, להקשיב לאורך זמן, לעקוב אחרי הוראות, לנהל ילקוט ולהתחיל לרכוש קריאה וכתיבה. רוב הילדים מסתגלים יפה, אבל ילד שמגיע מוכן חווה את השנה הראשונה בצורה אחרת לגמרי.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה בכלל \"מוכנות לכיתה א'\"?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">מוכנות היא לא רק \"לדעת אותיות\". היא משלבת כמה תחומים:</p>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות לימודית:</strong> היכרות עם האותיות והצלילים שלהן, יכולת לפרק מילה להברות ולצלילים ולהרכיב אותם בחזרה, זיהוי מספרים, ספירה והבנה בסיסית של כמות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות מוטורית:</strong> אחיזת עיפרון נכונה, גזירה, העתקה מהלוח ושליטה בתנועות הקטנות של היד.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קשב והתמדה:</strong> היכולת להישאר במשימה עד הסוף, גם כשהיא פחות מעניינת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>מוכנות רגשית וחברתית:</strong> ביטחון עצמי, יכולת להתמודד עם תסכול, לבקש עזרה, לחכות לתור ולהשתלב בקבוצה.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>למה כדאי להתחיל לפני כיתה א'?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">ילד שמגיע לכיתה א' כשהוא כבר מכיר את האותיות ושולט בפירוק והרכבה של צלילים, לא צריך להתחיל את התהליך אחרי כולם. הוא יכול להתפנות לדברים החשובים באמת בתחילת הדרך: להכיר חברים, להתרגל למורה ולמסגרת, ולהרגיש שהוא מצליח. ההרגשה \"אני מצליח\" בחודשים הראשונים בונה את היחס של הילד ללמידה לשנים קדימה.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">נכון, לגן יש תפקיד חשוב בהכנה. ונכון, יש ילדים שקולטים הכול לבד. אבל לא כל ילד מגיע עם אותו בסיס, ופערים קטנים בתחילת כיתה א' נוטים לגדול אם לא מטפלים בהם בזמן.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>סימנים שכדאי לשים לב אליהם</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\">הילד מתקשה לזהות את הצליל הראשון במילה (\"באיזה צליל מתחילה המילה בית?\").</li>\n        <li mbr-text data-app-selector=\".ma-content li\">קשה לו לשבת כמה דקות ברצף מול משימה שולחנית.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא נמנע מציור, צביעה או כתיבה, או מחזיק את העיפרון בצורה לא נוחה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא נלחץ מאוד ממצבים חדשים או מוותר מהר כשמשהו לא מצליח.</li>\n      </ul>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">אף אחד מהסימנים האלה הוא לא סיבה לדאגה. הם פשוט מראים לנו איפה כדאי לחזק.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה אפשר לעשות בבית?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>משחקי צלילים:</strong> \"אני רואה משהו שמתחיל בצליל מ...\", חרוזים, מחיאות כפיים לכל הברה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה משותפת:</strong> לקרוא יחד כל ערב, לעצור ולשאול \"מה לדעתך יקרה עכשיו?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>חשבון ביום-יום:</strong> לספור מדרגות, להשוות כמויות בצלחת, לשחק משחקי קופסה עם קובייה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>עצמאות:</strong> לתת לילד לארגן תיק, להתלבש לבד ולסיים משימה קטנה עד הסוף.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לדבר על בית הספר בחיוב:</strong> לספר מה מחכה לו ולהימנע מהפחדות כמו \"בכיתה א' כבר לא משחקים\".</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך אנחנו עובדים במרכז מא-ת</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">במרכז למידה מא-ת בבאר שבע ההכנה לכיתה א' נעשית בקבוצות קטנות, דרך משחקים, חוויה והרבה הנאה. הדר נזרית-ראובן, מורה להוראה מתקנת עם תואר ראשון בחינוך מיוחד ו-15 שנות ניסיון, בונה לכל ילד תוכנית שמשלבת את הבסיס הלימודי (אותיות, צלילים, חשבון) יחד עם חיזוק הביטחון העצמי והמוכנות הרגשית.</p>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">למשפחות שרוצות לתרגל גם בבית, יש את <strong>ערכת ההכנה לכיתה א'</strong> של המרכז: משחקים דידקטיים וחוברות פעילות בשפה ובחשבון, שמאפשרים לילד להתקדם בקצב שלו ובסביבה רגועה.</p>\n      </div>\n      <aside class=\"ma-cta\">\n        <h2 class=\"ma-cta-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-cta-title\"><strong>רוצים להתייעץ?</strong></h2>\n        <p class=\"ma-cta-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-cta-text\">השאירו פרטים או התקשרו, ונחזור אליכם עם המלצה מותאמת לילד שלכם.</p>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"tel:+972543982557\" data-app-placeholder=\"Type Text\">054-398-2557</a> <a class=\"btn btn-white-outline\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">השאירו פרטים</a></div>\n      </aside>\n      <div class=\"ma-related\">\n        <h2 class=\"ma-related-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-related-title\"><strong>מאמרים נוספים</strong></h2>\n        <div class=\"ma-related-grid\">\n        <a class=\"ma-related-card\" href=\"article-middle-school.html\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מיסודי לחטיבת ביניים</span></a>\n        <a class=\"ma-related-card\" href=\"article-reading-fluency.html\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">דיוק ושטף בקריאה ואסטרטגיות למידה</span></a>\n        </div>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary-outline\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
