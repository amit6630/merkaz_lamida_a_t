              "margin": "0",
              "padding": "0"
            },
            ".ma-facts li": {
              "padding": "7px 14px",
              "border-radius": "999px",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .25)",
              "font-size": ".95rem",
              "color": "#4a4434"
            },
            ".ma-wh-index": {
              "display": "grid",
              "gap": "14px"
            },
            ".ma-wh-card": {
              "display": "grid",
              "grid-template-columns": "96px 1fr",
              "grid-template-rows": "auto auto auto",
              "column-gap": "18px",
              "align-items": "center",
              "padding": "12px",
              "border-radius": "22px",
              "background": "#ffffff",
              "text-decoration": "none !important",
              "box-shadow": "0 18px 36px -26px rgba(58, 52, 28, .55)",
              "border": "1px solid rgba(154, 130, 98, .14)",
              "transition": "transform .3s, box-shadow .3s"
            },
            ".ma-wh-card:hover": {
              "transform": "translateX(-6px)",
              "box-shadow": "0 22px 40px -24px rgba(58, 52, 28, .6)"
            },
            ".ma-wh-card img": {
              "grid-row": "1 / 4",
              "width": "96px",
              "height": "96px",
              "object-fit": "cover",
              "border-radius": "16px !important"
            },
            ".ma-wh-num": {
              "font-family": "'Fredoka', sans-serif",
              "color": "@mainColor",
              "font-weight": "600",
              "font-size": ".95rem",
              "grid-column": "2"
            },
            ".ma-wh-name": {
              "grid-column": "2",
              "font-family": "'Fredoka', sans-serif",
              "font-weight": "600",
              "font-size": "1.35rem",
              "color": "@textColor",
              "line-height": "1.2"
            },
            ".ma-wh-age": {
              "grid-column": "2",
              "color": "#6b6352",
