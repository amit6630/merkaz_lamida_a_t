              "position": "relative"
            },
            ".ma-link": {
              "display": "block",
              "padding": "9px 14px",
              "border-radius": "999px",
              "color": "@textColor !important",
              "font-weight": "500",
              "font-size": "1rem",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
