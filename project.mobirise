            ".ma-btn-ghost": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "13px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "text-decoration": "none !important",
              "transition": "transform .25s, box-shadow .25s",
              "color": "@textColor !important",
              "background": "#ffffff",
              "border": "1px solid rgba(154, 130, 98, .35)"
            },
            ".ma-btn-ghost:hover": {
