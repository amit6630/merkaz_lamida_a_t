      },
      "components": [
        {
          "_name": "ma-nav",
          "_sourceTheme": "startm5",
          "_styles": {
            "position": "sticky",
            "top": "0",
            "z-index": "1030",
            "direction": "rtl",
            "padding": "0",
            "background": "rgba(255, 255, 255, .9)",
            "-webkit-backdrop-filter": "saturate(160%) blur(14px)",
            "backdrop-filter": "saturate(160%) blur(14px)",
            "border-bottom": "1px solid rgba(154, 130, 98, .18)",
            "box-shadow": "0 10px 30px -24px rgba(58, 52, 28, .5)",
            ".ma-toggle": {
              "position": "absolute",
              "opacity": "0",
              "pointer-events": "none",
              "width": "1px",
              "height": "1px"
            },
            ".ma-bar": {
              "max-width": "1260px",
              "margin": "0 auto",
              "height": "80px",
              "padding": "0 clamp(16px, 3vw, 36px)",
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "20px"
            },
            ".ma-logo": {
              "display": "block",
              "flex": "none"
            },
            ".ma-logo img": {
              "height": "60px",
              "width": "auto",
              "display": "block",
              "border-radius": "0 !important",
              "mix-blend-mode": "multiply"
            },
            ".ma-links": {
              "display": "flex",
              "align-items": "center",
              "gap": "2px",
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-links li": {
              "position": "relative"
            },
            ".ma-link": {
              "display": "block",
              "padding": "9px 14px",
              "border-radius": "999px",
              "color": "@textColor !important",
              "font-weight": "500",
              "font-size": "1rem",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
            ".ma-link:hover, .ma-link:focus-visible": {
              "background": "rgba(183, 162, 132, .18)",
              "color": "@mainColor !important"
            },
            ".ma-has-sub > .ma-link::after": {
              "content": "''",
              "display": "inline-block",
              "width": "6px",
              "height": "6px",
              "margin-right": "8px",
              "border-left": "2px solid currentColor",
              "border-bottom": "2px solid currentColor",
              "transform": "translateY(-3px) rotate(-45deg)"
            },
            ".ma-sub": {
              "position": "absolute",
              "top": "calc(100% + 8px)",
              "right": "0",
              "min-width": "250px",
              "list-style": "none",
              "margin": "0",
              "padding": "10px",
              "background": "#ffffff",
              "border-radius": "18px",
              "box-shadow": "0 24px 50px -24px rgba(58, 52, 28, .45)",
              "border": "1px solid rgba(154, 130, 98, .15)",
              "opacity": "0",
              "visibility": "hidden",
              "transform": "translateY(6px)",
              "transition": "opacity .25s, transform .25s, visibility .25s"
            },
            ".ma-sub::before": {
              "content": "''",
              "position": "absolute",
              "top": "-10px",
              "right": "0",
              "left": "0",
              "height": "10px"
            },
            ".ma-has-sub:hover .ma-sub, .ma-has-sub:focus-within .ma-sub": {
              "opacity": "1",
              "visibility": "visible",
              "transform": "none"
            },
            ".ma-sublink": {
              "display": "block",
              "padding": "10px 14px",
              "border-radius": "12px",
              "color": "@textColor !important",
              "text-decoration": "none !important",
              "font-size": ".97rem"
            },
            ".ma-sublink:hover": {
              "background": "#f8f4ee",
              "color": "@mainColor !important"
            },
            ".ma-actions": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "flex": "none"
            },
            ".ma-phone": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "color": "@textColor !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".ma-phone .mbr-iconfont": {
              "width": "40px",
              "height": "40px",
              "border-radius": "50%",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "rgba(183, 162, 132, .18)",
              "color": "@mainColor",
              "font-size": "18px"
            },
            ".ma-cta": {
              "display": "inline-flex",
              "align-items": "center",
              "padding": "11px 22px",
              "border-radius": "999px",
              "color": "#ffffff !important",
              "font-weight": "600",
              "text-decoration": "none !important",
              "background": "linear-gradient(120deg, #8a7458, #b7a284)",
              "box-shadow": "0 12px 24px -14px rgba(58, 52, 28, .7)",
              "transition": "transform .25s, box-shadow .25s",
              "white-space": "nowrap"
            },
            ".ma-cta:hover": {
              "transform": "translateY(-2px)",
              "box-shadow": "0 16px 28px -14px rgba(58, 52, 28, .75)"
            },
            ".ma-burger": {
              "display": "none",
              "width": "46px",
              "height": "46px",
              "border-radius": "50%",
              "margin": "0",
              "cursor": "pointer",
              "background": "rgba(183, 162, 132, .18)",
              "position": "relative"
            },
            ".ma-burger span": {
              "position": "absolute",
              "right": "13px",
              "left": "13px",
              "height": "2px",
              "border-radius": "2px",
              "background": "@textColor",
              "transition": "transform .3s, opacity .3s, top .3s"
            },
            ".ma-burger span:nth-child(1)": {
              "top": "16px"
            },
            ".ma-burger span:nth-child(2)": {
              "top": "22px"
            },
            ".ma-burger span:nth-child(3)": {
              "top": "28px"
            },
            ".ma-toggle:checked ~ .ma-bar .ma-burger span:nth-child(1)": {
              "top": "22px",
              "transform": "rotate(45deg)"
            },
            ".ma-toggle:checked ~ .ma-bar .ma-burger span:nth-child(2)": {
              "opacity": "0"
            },
            ".ma-toggle:checked ~ .ma-bar .ma-burger span:nth-child(3)": {
              "top": "22px",
              "transform": "rotate(-45deg)"
            },
            ".ma-toggle:focus-visible ~ .ma-bar .ma-burger": {
              "outline": "3px solid @mainColor",
              "outline-offset": "2px"
            },
            ".ma-panel": {
              "display": "none"
            },
            "@media (max-width: 1100px)": {
              ".ma-phone-num": {
                "display": "none"
              }
            },
            "@media (max-width: 991px)": {
              ".ma-menu": {
                "display": "none"
              },
              ".ma-burger": {
                "display": "block"
              },
              ".ma-bar": {
                "height": "68px"
              },
              ".ma-logo img": {
                "height": "48px"
              },
              ".ma-actions .ma-cta": {
                "display": "none"
              },
              ".ma-panel": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "position": "fixed",
                "top": "68px",
                "right": "0",
                "left": "0",
                "height": "calc(100vh - 68px)",
                "overflow-y": "auto",
                "padding": "18px 22px 28px",
                "background": "#f8f4ee",
                "opacity": "0",
                "visibility": "hidden",
                "transform": "translateY(-8px)",
                "transition": "opacity .3s, transform .3s, visibility .3s"
              },
              ".ma-toggle:checked ~ .ma-panel": {
                "opacity": "1",
                "visibility": "visible",
                "transform": "none"
              },
              ".ma-plinks": {
                "list-style": "none",
                "margin": "0",
                "padding": "0"
              },
              ".ma-plinks > li": {
                "border-bottom": "1px solid rgba(154, 130, 98, .2)"
              },
              ".ma-plinks .ma-link": {
                "font-size": "1.35rem",
                "padding": "14px 4px",
                "border-radius": "0",
                "background": "none !important"
              },
              ".ma-plinks .ma-sub": {
                "position": "static",
                "opacity": "1",
                "visibility": "visible",
                "transform": "none",
                "box-shadow": "none",
                "border": "0",
                "background": "transparent",
                "padding": "0 14px 10px",
                "min-width": "0"
              },
              ".ma-plinks .ma-has-sub > .ma-link::after": {
                "display": "none"
              },
              ".ma-pfoot": {
                "display": "flex",
                "flex-direction": "column",
                "gap": "12px",
                "padding-top": "22px"
              },
              ".ma-pfoot .ma-cta": {
                "justify-content": "center",
                "padding": "15px"
              },
              ".ma-pphone": {
                "text-align": "center",
                "color": "@textColor !important",
                "font-size": "1.1rem",
                "text-decoration": "none !important"
              },
              "-webkit-backdrop-filter": "none",
              "backdrop-filter": "none",
              "background": "#ffffff",
              "overflow": "visible"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-nav\" group=\"Custom\" global once=\"menu\" always-top not-draggable>\n  <mbr-parameters>\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n  </mbr-parameters>\n  <input type=\"checkbox\" id=\"maNavToggle\" class=\"ma-toggle\" aria-label=\"פתיחת התפריט\">\n  <div class=\"ma-bar\">\n    <a class=\"ma-logo\" href=\"index.html\" aria-label=\"מרכז למידה מא-ת – דף הבית\"><img src=\"@PROJECT_PATH@/assets/images/logo-card.jpg\" alt=\"מא' ועד ת' – הדר נזרית-ראובן\" width=\"680\" height=\"430\"></a>\n    <nav class=\"ma-menu\" aria-label=\"תפריט ראשי\"><ul class=\"ma-links\"><li class=\"ma-has-sub\"><a class=\"ma-link\" href=\"workshops.html\" mbr-text>הסדנאות</a><ul class=\"ma-sub\"><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-g\" mbr-text>הכנה לכיתה א'</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-y\" mbr-text>מתמטיקה ושפה (ב'-ו')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-15\" mbr-text>דיוק ושטף בקריאה (א'-ג')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html\" mbr-text>כל הסדנאות</a></li></ul></li><li><a class=\"ma-link\" href=\"index.html#slider01-1s\" mbr-text>ערכת ההכנה</a></li><li><a class=\"ma-link\" href=\"index.html#people03-k\" mbr-text>אודות</a></li><li><a class=\"ma-link\" href=\"articles.html\" mbr-text>מאמרים</a></li><li><a class=\"ma-link\" href=\"index.html#faq\" mbr-text>שאלות נפוצות</a></li><li><a class=\"ma-link\" href=\"index.html#contacts3-s\" mbr-text>צור קשר</a></li></ul></nav>\n    <div class=\"ma-actions\">\n      <a class=\"ma-phone\" href=\"tel:+972543982557\" aria-label=\"התקשרו 054-398-2557\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\"></span><span class=\"ma-phone-num\" dir=\"ltr\">054-398-2557</span></a>\n      <a class=\"ma-cta\" href=\"index.html#form02-9\" mbr-text>לשיחת ייעוץ</a>\n      <label for=\"maNavToggle\" class=\"ma-burger\" aria-label=\"תפריט\"><span></span><span></span><span></span></label>\n    </div>\n  </div>\n  <div class=\"ma-panel\">\n    <ul class=\"ma-plinks\"><li class=\"ma-has-sub\"><a class=\"ma-link\" href=\"workshops.html\" mbr-text>הסדנאות</a><ul class=\"ma-sub\"><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-g\" mbr-text>הכנה לכיתה א'</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-y\" mbr-text>מתמטיקה ושפה (ב'-ו')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-15\" mbr-text>דיוק ושטף בקריאה (א'-ג')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html\" mbr-text>כל הסדנאות</a></li></ul></li><li><a class=\"ma-link\" href=\"index.html#slider01-1s\" mbr-text>ערכת ההכנה</a></li><li><a class=\"ma-link\" href=\"index.html#people03-k\" mbr-text>אודות</a></li><li><a class=\"ma-link\" href=\"articles.html\" mbr-text>מאמרים</a></li><li><a class=\"ma-link\" href=\"index.html#faq\" mbr-text>שאלות נפוצות</a></li><li><a class=\"ma-link\" href=\"index.html#contacts3-s\" mbr-text>צור קשר</a></li></ul>\n    <div class=\"ma-pfoot\"><a class=\"ma-cta\" href=\"index.html#form02-9\">לשיחת ייעוץ</a><a class=\"ma-pphone\" href=\"tel:+972543982557\" dir=\"ltr\">054-398-2557</a></div>\n  </div>\n</section>",
