        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bg-value",
            ".mbr-section-title": {
              "color": "#b7a284",
              "font-weight": "700"
            },
            ".mbr-section-subtitle": {
              "color": "#767676"
            },
            ".card-wrapper": {
              "display": "flex",
              "flex-direction": "row-reverse",
              "align-items": "center",
              "padding": "1.5rem",
              "background": "@cardsBg",
              "border-radius": "15px",
              "box-shadow": "0 5px 15px rgba(0, 0, 0, 0.05)",
              "transition": "transform 0.3s",
              "&:hover": {
                "transform": "translateY(-5px)"
              }
            },
            ".icon-box": {
              "margin-left": "1.5rem"
            },
            ".mbr-iconfont": {
              "font-size": "2rem",
              "color": "#b7a284",
              "background": "#fdfaf5",
              "padding": "15px",
              "border-radius": "50%"
            },
            ".text-wrapper": {
              "text-align": "right",
              "width": "100%"
            },
            ".card-title": {
              "color": "#b7a284"
            },
            ".mbr-text a": {
              "color": "#767676 !important",
              "text-decoration": "none",
              "&:hover": {
                "color": "#b7a284 !important"
              }
            },
            ".map-wrapper": {
              "border-radius": "15px",
              "overflow": "hidden",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.1)",
              "min-height": "350px"
            },
            ".google-map": {
              "height": "100%",
              "iframe": {
                "width": "100%",
                "height": "100%",
                "border": "0"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "flex-direction": "column-reverse"
              },
              ".map-wrapper": {
                "margin-bottom": "2rem"
              }
            }
          },
          "_name": "contacts3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contacts3 map1\" group=\"Maps\">\n\n\n\n    <mbr-parameters>\n\n        <header>Size</header>\n\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n\n        <header>Show/Hide</header>\n\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\n        <input type=\"color\" title=\"BG\" name=\"cardsBg\" value=\"#fafafa\">\n\n        <header>Map</header>\n\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3410.0610181452703!2d34.81831092579897!3d31.27440735925534!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x150266e22d926295%3A0xf1ea33acda691402!2z16jXpNeQ15wg15DXmdeq158gMywg15HXkNeoINep15HXog!5e0!3m2!1siw!2sil!4v1710929697280!5m2!1siw!2sil&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3410.0610181452703!2d34.81831092579897!3d31.27440735925534!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x150266e22d926295%3A0xf1ea33acda691402!2z16jXpNeQ15wg15DXmdeq158gMywg15HXkNeoINep15HXog!5e0!3m2!1siw!2sil!4v1710929697280!5m2!1siw!2sil&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n\n        <header>Background</header>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head mb-5\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">צרו קשר</h3>\n            <h4 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">בואו נתחיל את התהליך ביחד</h4>\n        </div>\n        \n        <div class=\"row justify-content-center\">\n            <!-- כרטיסי קשר -->\n            <div class=\"col-12 col-md-6 custom-cards-col\">\n                <!-- טלפון -->\n                <div class=\"card-wrapper mb-4\">\n                    <div class=\"icon-box\">\n                        <span icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-5\"><b>טלפון</b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\">\n                            <a href=\"tel:+972543982557\" class=\"text-primary\">054-398-2557</a>\n                        </p>\n                    </div>\n                </div>\n\n                <!-- אימייל -->\n                <div class=\"card-wrapper mb-4\">\n                    <div class=\"icon-box\">\n                        <span icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-5\"><b>אימייל</b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\">\n                            <a href=\"mailto:hadar30484@walla.com\" class=\"text-primary\">hadar30484@walla.com</a>\n                        </p>\n                    </div>\n                </div>\n                \n                <!-- כתובת -->\n                <div class=\"card-wrapper\">\n                    <div class=\"icon-box\">\n                        <span icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-5\"><b>מיקום המרכז</b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\">מתנס הרוח היהודית, באר שבע</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- מפה -->\n            <div class=\"map-wrapper col-12 col-md-6\">\n                <div class=\"google-map\" mbr-map=\"googleMap\"></div>\n            </div>\n        </div>\n    </div>\n</section>",
