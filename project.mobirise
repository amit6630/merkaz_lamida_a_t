        },
        {
          "_name": "ma-article",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "direction": "rtl",
            "color": "@textColor",
            ".ma-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".ma-crumbs": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px",
              "font-size": "1rem",
              "color": "#8a8170",
              "margin-bottom": "1.5rem"
            },
            ".ma-crumbs a": {
              "color": "@mainColor",
              "text-decoration": "none"
            },
            ".ma-crumbs a:hover": {
              "text-decoration": "underline"
            },
            ".ma-tag": {
              "display": "inline-block",
              "background": "rgba(183, 162, 132, .18)",
              "color": "#7a6648",
              "border-radius": "999px",
              "padding": "4px 14px",
              "font-size": ".95rem",
              "font-weight": "700",
              "margin-bottom": "1rem"
            },
            ".ma-art-title": {
              "color": "@textColor",
              "margin-bottom": "1rem",
              "line-height": "1.2"
            },
            ".ma-lead": {
              "color": "#5b5446",
              "margin-bottom": "1rem",
              "line-height": "1.6"
            },
            ".ma-byline": {
              "color": "#8a8170",
              "font-size": "1rem",
              "margin": "0"
            },
            ".ma-hero": {
              "margin": "2.5rem 0",
              "border-radius": "26px",
              "overflow": "hidden",
              "box-shadow": "0 24px 50px -28px rgba(58, 52, 28, .45)"
            },
            ".ma-hero img": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-height": "520px",
              "object-fit": "cover",
              "border-radius": "0"
            },
            ".ma-content h2": {
              "color": "@textColor",
              "margin": "2.5rem 0 1rem",
              "padding-right": "14px",
              "border-right": "4px solid @mainColor"
            },
            ".ma-content p": {
              "color": "#3f3a2c",
              "line-height": "1.85",
              "margin-bottom": "1.1rem"
            },
            ".ma-content ul": {
              "margin": "0 0 1.4rem",
              "padding-right": "1.25rem",
              "padding-left": "0"
            },
            ".ma-content li": {
              "color": "#3f3a2c",
              "line-height": "1.8",
              "margin-bottom": ".5rem"
            },
            ".ma-content li::marker": {
              "color": "@mainColor"
            },
            ".ma-cta": {
              "margin-top": "3rem",
              "padding": "32px 28px",
              "border-radius": "24px",
              "background": "@mainColor",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".ma-cta-title": {
              "color": "#ffffff",
              "margin-bottom": ".5rem"
            },
            ".ma-cta-text": {
              "color": "#ffffff",
              "opacity": ".92",
              "margin-bottom": "0"
            },
            ".ma-cta .mbr-section-btn": {
              "margin-top": "1.25rem"
            },
            ".ma-cta .btn-white": {
              "color": "#3a341c !important"
            },
            ".ma-related": {
              "margin-top": "3.5rem"
            },
            ".ma-related-title": {
              "color": "@textColor",
              "margin-bottom": "1.25rem"
            },
            ".ma-related-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px"
            },
            "@media (min-width: 768px)": {
              ".ma-related-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            ".ma-related-card": {
              "display": "flex",
              "gap": "14px",
              "align-items": "center",
              "padding": "12px",
              "background": "#ffffff",
              "border-radius": "18px",
              "text-decoration": "none",
              "box-shadow": "0 12px 30px -22px rgba(58, 52, 28, .4)",
              "transition": "transform .3s ease"
            },
            ".ma-related-card:hover": {
              "transform": "translateY(-4px)"
            },
            ".ma-related-card img": {
              "width": "84px",
              "height": "84px",
              "object-fit": "cover",
              "border-radius": "14px",
              "flex": "none"
            },
            ".ma-related-card span": {
              "color": "@textColor",
              "font-weight": "700",
              "line-height": "1.4",
              "font-size": "1.05rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-article\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wrap\">\n      <nav class=\"ma-crumbs\" aria-label=\"מיקום בעמוד\"><a href=\"index.html\">דף הבית</a><span aria-hidden=\"true\">/</span><a href=\"articles.html\">מאמרים</a></nav>\n      <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">קריאה ולמידה</span>\n      <h1 class=\"ma-art-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-art-title\"><strong>דיוק ושטף בקריאה, ואסטרטגיות למידה בשפה ובחשבון</strong></h1>\n      <p class=\"ma-lead mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-lead\">מה ההבדל בין דיוק לשטף בקריאה, למה שניהם חשובים להבנת הנקרא, ואילו אסטרטגיות למידה עוזרות לילדים להצליח בשפה ובחשבון.</p>\n      <p class=\"ma-byline\" mbr-text data-app-selector=\".ma-byline\">מאת הדר נזרית-ראובן, מורה להוראה מתקנת · מרכז למידה מא-ת, באר שבע</p>\n      <figure class=\"ma-hero\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\"></figure>\n      <div class=\"ma-content\">\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">קריאה וכתיבה הן מיומנויות חובה לכל החיים, והן הבסיס להצלחה בלימודים. ילד שקורא לאט ובמאמץ משקיע את כל האנרגיה בפענוח המילים, ולא נשאר לו כוח להבין מה קרא. לכן כשאנחנו מדברים על קריאה טובה, אנחנו מדברים על שני מרכיבים: <strong>דיוק</strong> ו<strong>שטף</strong>.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה דיוק בקריאה?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">דיוק הוא היכולת לקרוא את המילה כפי שהיא כתובה: לזהות נכון את האותיות ואת סימני הניקוד, ולא להחליף, להשמיט או \"לנחש\" מילים. ילד שקורא \"בית\" במקום \"בת\", או מדלג על סופי מילים, עלול להבין את הטקסט לא נכון גם אם הוא קורא מהר.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה שטף בקריאה?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">שטף הוא היכולת לקרוא בקצב טבעי, ברצף ובהטעמה נכונה, כמעט כמו בדיבור. כשהקריאה שוטפת, הפענוח הופך לאוטומטי, והראש מתפנה להבנה. שטף לא אומר \"לקרוא הכי מהר שאפשר\". הוא אומר לקרוא בקצב שמאפשר להבין.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>סימנים לקושי בדיוק או בשטף</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\">הילד קורא לאט מאוד, מילה אחרי מילה, או חוזר על אותה מילה כמה פעמים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מחליף אותיות דומות (ב/כ, ד/ר, ה/ח) או מתבלבל בניקוד.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מנחש מילים לפי האות הראשונה או לפי התמונה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מתעייף מהר מקריאה ונמנע ממנה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא \"קרא\" את הטקסט אבל לא יודע לספר מה היה בו.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך מחזקים דיוק ושטף?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>חיזוק הבסיס הצלילי:</strong> תרגול הקשר בין אות לצליל, פירוק והרכבה של הברות ומילים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה חוזרת:</strong> לקרוא את אותו קטע קצר כמה פעמים. בכל פעם הקריאה נעשית מדויקת ושוטפת יותר, והילד מרגיש את ההתקדמות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה בזוגות ובמקהלה:</strong> המבוגר קורא משפט והילד חוזר אחריו, או שקוראים יחד. כך הילד שומע איך נשמעת קריאה שוטפת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>טקסטים ברמה המתאימה:</strong> לא קלים מדי ולא קשים מדי, כדי שהילד יצליח ויתקדם.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>עבודה בצעדים קטנים:</strong> הצלחות קטנות ועקביות בונות ביטחון, והביטחון בונה מוטיבציה.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>אסטרטגיות למידה בשפה</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לפני הקריאה:</strong> להסתכל על הכותרת ועל התמונות ולשאול \"על מה הטקסט הזה, לדעתי?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>בזמן הקריאה:</strong> לעצור בסוף פסקה ולשאול \"מה הבנתי עד עכשיו?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>אחרי הקריאה:</strong> לספר את הטקסט במילים שלי, לסמן את המשפט החשוב ולענות על שאלות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>בכתיבה:</strong> לתכנן לפני שכותבים (מה אני רוצה להגיד), לכתוב, ואז לקרוא שוב ולתקן.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>אסטרטגיות למידה בחשבון</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>להבין לפני שמשננים:</strong> להשתמש בחפצים, בציורים ובקווי מספרים כדי שהילד יראה מה קורה בתרגיל.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לקרוא את השאלה פעמיים:</strong> בבעיות מילוליות, לסמן מה נתון ומה שואלים. כאן הקריאה והחשבון נפגשים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לפרק לשלבים:</strong> בעיה גדולה היא כמה בעיות קטנות. פותרים אחת-אחת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לבדוק את התשובה:</strong> האם התוצאה הגיונית? אפשר לבדוק בדרך אחרת?</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לתרגל באופן עצמאי:</strong> בהדרגה, הילד לומד לפתור לבד ולסמוך על עצמו.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך אנחנו עובדים במרכז מא-ת</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">במרכז למידה מא-ת בבאר שבע פועלות קבוצות קטנות לחיזוק דיוק ושטף בקריאה ובכתיבה לילדי כיתות א'-ג', וקבוצות במתמטיקה ובשפה לכיתות ב'-ו'. הדר נזרית-ראובן משלבת שיטת למידה מתקדמת וחווייתית, בונה לכל תלמיד תוכנית אישית לצמצום פערים, ומקפידה על מעטפת רגשית שמחזקת את הביטחון העצמי. כי כשהילד מרגיש שרואים אותו, הלמידה מתחילה לזרום.</p>\n      </div>\n      <aside class=\"ma-cta\">\n        <h2 class=\"ma-cta-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-cta-title\"><strong>רוצים להתייעץ?</strong></h2>\n        <p class=\"ma-cta-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-cta-text\">השאירו פרטים או התקשרו, ונחזור אליכם עם המלצה מותאמת לילד שלכם.</p>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"tel:+972543982557\" data-app-placeholder=\"Type Text\">054-398-2557</a> <a class=\"btn btn-white-outline\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">השאירו פרטים</a></div>\n      </aside>\n      <div class=\"ma-related\">\n        <h2 class=\"ma-related-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-related-title\"><strong>מאמרים נוספים</strong></h2>\n        <div class=\"ma-related-grid\">\n        <a class=\"ma-related-card\" href=\"article-first-grade.html\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מגן חובה לכיתה א'</span></a>\n        <a class=\"ma-related-card\" href=\"article-middle-school.html\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מיסודי לחטיבת ביניים</span></a>\n        </div>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary-outline\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
