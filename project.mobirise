    "terms.html": {
      "settings": {
        "title": "תנאי שימוש | מרכז למידה מא-ת",
        "order": "8",
        "meta_descr": "תנאי השימוש באתר מרכז למידה מא-ת: מטרת האתר, המידע והמאמרים, הרשמה לשירותים, רכישת ערכת ההכנה וקניין רוחני.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/terms.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/terms.html\">\n<meta property=\"og:title\" content=\"תנאי שימוש | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"תנאי השימוש באתר מרכז למידה מא-ת: מטרת האתר, המידע והמאמרים, הרשמה לשירותים, רכישת ערכת ההכנה וקניין רוחני.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/logo-card.jpg\">",
        "footer_custom": "",
