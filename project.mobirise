        "meta_descr": "המעבר הזה הוא אחד השלבים המרגשים והמאתגרים בחיי הילד! מה זה בעצם \"מוכנות לכיתה א'\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה?",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/article-first-grade.html\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/article-first-grade.html\">\n<meta property=\"og:title\" content=\"המעבר מגן חובה לכיתה א' | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"המעבר הזה הוא אחד השלבים המרגשים והמאתגרים בחיי הילד! מה זה בעצם &quot;מוכנות לכיתה א'&quot;, אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה?\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/service-first-grade.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Article\",\n      \"headline\": \"המעבר מגן חובה לכיתה א': איך נדע שהקטנטנים מגיעים מוכנים, רגועים ובטוחים?\",\n      \"description\": \"המעבר הזה הוא אחד השלבים המרגשים והמאתגרים בחיי הילד! מה זה בעצם \\\"מוכנות לכיתה א'\\\", אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה?\",\n      \"inLanguage\": \"he\",\n      \"url\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\",\n      \"mainEntityOfPage\": \"https://merkaz-lamida-a-t.com/article-first-grade.html\",\n      \"image\": \"https://merkaz-lamida-a-t.com/assets/images/service-first-grade.jpg\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"הדר נזרית-ראובן\",\n        \"jobTitle\": \"מורה להוראה מתקנת\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"מרכז למידה מא-ת\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\"\n        }\n      }\n    },\n    {\n      \"@type\": \"