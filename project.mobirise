                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo": {
                  "img": {
                    "height": "2.5rem !important"
                  }
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "0.5rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "2px solid #e6e6e6",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 0.5em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".navbar-caption": {},
            ".navbar-nav": {},
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar-brand": {
              "min-height": "70px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "70px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "31px",
              "height": "20px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-buttons .btn": {
              "padding": "1rem 1.2rem !important",
              "border-radius": "50px !important",
              "background-color": "#b7a284 !important",
              "color": "#ffffff !important",
              "border": "none !important"
            }
          },
          "_name": "menu1",
          "_sourceTheme": "curem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Phone\" name=\"showPhone\">\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"15\" step=\"0.1\" value=\"9.3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n</select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#b7a284\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#b7a284\">\n    </mbr-parameters>\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        \n         <h3 class=\"menu-tite mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".menu-tite\" mbr-if=\"showText\">&nbsp;הוראה מתקנת בבאר שבע והסביבה</h3>\n\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n         \n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    \n                        <img src=\"@PROJECT_PATH@/assets/images/logo-211.jpg\" alt=\"מרכז למידה מא-ת\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    \n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-primary\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">CureM4</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-7\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item dropdown\"><a class=\"nav-link link text-primary dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">השירותים שלי</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-857\"><a class=\"text-primary dropdown-item\" href=\"workshops.html#header14-d\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">קצת על הסדנאות שלי</a><a class=\"text-primary dropdown-item\" href=\"workshops.html#timeline3-g\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">הכנה לכיתה א'</a><a class=\"text-primary dropdown-item\" href=\"workshops.html#timeline3-y\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">מתמטיקה ושפה (ב'-ו') </a><a class=\"text-primary dropdown-item\" href=\"workshops.html#timeline3-15\" style=\"text-align:right\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">דיוק ושטף בקריאה (א'-ג')</a></div></li>\n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link text-primary dropdown-toggle\" href=\"index.html#slider01-1s\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">ערכת ההכנה</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-736\"><a class=\"text-primary show dropdown-item\" href=\"index.html#slider01-1s\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">על הערכה</a><a class=\"text-primary show dropdown-item\" href=\"index.html#testimonials2-20\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">הורים מספרים</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-primary dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" style=\"text-align:right\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">אודות</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-410\"><a class=\"text-primary dropdown-item\" href=\"index.html#people03-k\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">הדר נזרית-ראובן</a><a class=\"text-primary dropdown-item\" href=\"index.html#features6-4\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">למה איתי</a><a class=\"text-primary dropdown-item\" href=\"index.html#slider04-2\" data-app-selector=\".nav-link,.dropdown-item\" style=\"text-align:right\" data-app-placeholder=\"Type Text\">קצת מהמרכז</a></div>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"articles.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" style=\"text-align:right\">מאמרים</a></li></ul>\n                \n                <h4 class=\"menu-text mbr-fonts-style m-0\" mbr-theme-style=\"display-4\" data-app-selector=\".menu-text\" mbr-if=\"showPhone\"></h4>\n                \n                \n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://www.instagram.com/merkaz_lemida_a_t/\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"tel:+972543982557\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">תשאירו פרטים</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "menu1-1t",
          "_isUserblock": true,
          "_cid": "u9gXAJsRLg",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "ma-articles",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "direction": "rtl",
            ".ma-head": {
              "text-align": "center",
              "max-width": "720px",
              "margin": "0 auto 3rem"
            },
            ".ma-kicker": {
              "display": "inline-block",
              "color": "@mainColor",
              "font-weight": "700",
              "letter-spacing": ".08em",
              "margin-bottom": ".75rem"
            },
            ".ma-title": {
              "color": "@textColor",
              "margin-bottom": "1rem"
            },
            ".ma-sub": {
              "color": "#5b5446",
              "margin": "0"
            },
            ".ma-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "28px"
            },
            "@media (min-width: 768px)": {
              ".ma-grid": {
                "grid-template-columns": "repeat(2, 1fr)"
              }
            },
            "@media (min-width: 992px)": {
              ".ma-grid": {
                "grid-template-columns": "repeat(3, 1fr)"
              }
            },
            ".ma-card": {
              "display": "flex",
              "flex-direction": "column",
              "background": "#ffffff",
              "border-radius": "22px",
              "overflow": "hidden",
              "box-shadow": "0 18px 40px -24px rgba(58, 52, 28, .35)",
              "transition": "transform .35s ease, box-shadow .35s ease"
            },
            ".ma-card:hover": {
              "transform": "translateY(-6px)",
              "box-shadow": "0 28px 50px -24px rgba(58, 52, 28, .45)"
            },
            ".ma-card-img": {
              "display": "block",
              "aspect-ratio": "4 / 3",
              "overflow": "hidden"
            },
            ".ma-card-img img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover",
              "border-radius": "0",
              "transition": "transform .6s ease"
            },
            ".ma-card:hover .ma-card-img img": {
              "transform": "scale(1.05)"
            },
            ".ma-card-body": {
              "display": "flex",
              "flex-direction": "column",
              "gap": ".75rem",
              "flex": "1",
              "padding": "24px 24px 28px"
            },
            ".ma-tag": {
              "align-self": "flex-start",
              "background": "rgba(183, 162, 132, .18)",
              "color": "#7a6648",
              "border-radius": "999px",
              "padding": "4px 14px",
              "font-size": ".95rem",
              "font-weight": "700"
            },
            ".ma-card-title": {
              "color": "@textColor",
              "margin": "0"
            },
            ".ma-card-title a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".ma-card-text": {
              "color": "#5b5446",
              "margin": "0",
              "flex": "1"
            },
            ".ma-more": {
              "color": "@mainColor",
              "font-weight": "700",
              "text-decoration": "none"
            },
            ".ma-more:hover": {
              "text-decoration": "underline"
            },
            ".mbr-section-btn": {
              "text-align": "center",
              "margin-top": "2.75rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-articles\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Content</header>\n    <input type=\"range\" inline title=\"Articles\" name=\"cards\" min=\"1\" max=\"6\" step=\"1\" value=\"3\">\n    <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#f8f4ee\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-head\">\n      <span class=\"ma-kicker mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-kicker\">מרכז למידה מא-ת</span>\n      <h1 class=\"ma-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-title\"><strong>מאמרים להורים</strong></h1>\n      <p class=\"ma-sub mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-sub\">כל מה שכדאי לדעת על מעברים בין מסגרות, קריאה, שפה וחשבון. הסברים ברורים וטיפים שאפשר ליישם כבר היום.</p>\n    </div>\n    <div class=\"ma-grid\">\n      <article class=\"ma-card\">\n        <a class=\"ma-card-img\" href=\"article-first-grade.html\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">הכנה לכיתה א'</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"article-first-grade.html\">המעבר מגן חובה לכיתה א'</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">מה זה בעצם מוכנות לכיתה א', אילו סימנים כדאי לזהות, ואיך מכינים את הילד בבית ובמרכז הלמידה.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"article-first-grade.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n      <article class=\"ma-card\" mbr-if=\"cards > 1\">\n        <a class=\"ma-card-img\" href=\"article-middle-school.html\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">מעבר לחטיבה</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"article-middle-school.html\">המעבר מיסודי לחטיבת ביניים</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">מה משתנה בחטיבת הביניים, אילו מיומנויות כדאי לחזק כבר ביסודי, ואיך הורים יכולים לעזור.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"article-middle-school.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n      <article class=\"ma-card\" mbr-if=\"cards > 2\">\n        <a class=\"ma-card-img\" href=\"article-reading-fluency.html\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">קריאה ולמידה</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"article-reading-fluency.html\">דיוק ושטף בקריאה ואסטרטגיות למידה</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">מה ההבדל בין דיוק לשטף בקריאה, ואילו אסטרטגיות עוזרות לילדים להצליח בשפה ובחשבון.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"article-reading-fluency.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n      <article class=\"ma-card\" mbr-if=\"cards > 3\">\n        <a class=\"ma-card-img\" href=\"articles.html\"><img src=\"@PROJECT_PATH@/assets/images/kit-01.jpg\" alt=\"מאמר חדש\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">נושא</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"articles.html\">כותרת המאמר</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">תקציר קצר של המאמר.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"articles.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n      <article class=\"ma-card\" mbr-if=\"cards > 4\">\n        <a class=\"ma-card-img\" href=\"articles.html\"><img src=\"@PROJECT_PATH@/assets/images/kit-01.jpg\" alt=\"מאמר חדש\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">נושא</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"articles.html\">כותרת המאמר</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">תקציר קצר של המאמר.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"articles.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n      <article class=\"ma-card\" mbr-if=\"cards > 5\">\n        <a class=\"ma-card-img\" href=\"articles.html\"><img src=\"@PROJECT_PATH@/assets/images/kit-01.jpg\" alt=\"מאמר חדש\" loading=\"lazy\"></a>\n        <div class=\"ma-card-body\">\n          <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">נושא</span>\n          <h3 class=\"ma-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-card-title\"><a href=\"articles.html\">כותרת המאמר</a></h3>\n          <p class=\"ma-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-card-text\">תקציר קצר של המאמר.</p>\n          <a class=\"ma-more mbr-fonts-style\" mbr-theme-style=\"display-7\" href=\"articles.html\" mbr-text data-app-selector=\".ma-more\">לקריאת המאמר &larr;</a>\n        </div>\n      </article>\n    </div>\n    <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n  </div>\n</section>",
          "_anchor": "ma-articles-2a",
          "_isUserblock": true,
          "_cid": "vrlGFb0Ekj",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".media-wrap": {
              "margin": "0 auto",
              "padding": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "1rem"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "text-align": "center",
                "& > div": {
                  "margin": "auto"
                }
              },
              ".social-row": {
                "justify-content": "center"
              }
            },
            ".social-row": {
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "1rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0rem"
              },
              "color": "#b7a284",
              "text-align": "center"
            },
            ".mbr-text": {
              "transition": ".2s all"
            },
            ".mbr-text:hover": {
              "color": "#b7a284"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "50%",
              "background-color": "@successColor",
              "margin-right": "0.5rem",
              "margin-bottom": "0.2rem",
              "padding": "0.5rem",
              "height": "2.5rem",
              "width": "2.5rem",
              "transition": ".2s all"
            },
            ".soc-item:hover": {
              "background-color": "#b7a284"
            },
            ".mbr-iconfont": {
              "color": "black"
            },
            ".flex": {
              "display": "flex",
              "@media (max-width: 990px)": {
                "display": "block"
              }
            },
            ".follow": {
              "vertical-align": "sub",
              "color": "#b7a284",
              "margin-right": "10px",
              "line-height": "2.5rem",
              "@media (max-width: 765px)": {
                "margin-right": "0px"
              },
              "text-align": "right"
            },
            ".footer-sotial": {
              "justify-content": "space-between"
            },
            ".rigth-col": {
              "text-align": "right",
              "@media (max-width: 765px)": {
                "text-align": "center"
              }
            },
            "@media (max-width: 991px)": {
              "div > *:last-child": {
                "margin-top": "0 !important"
              }
            },
            ".item-wrap": {
              "text-transform": "uppercase",
              "@media (max-width: 765px)": {
                "text-align": "center"
              }
            },
            "H5": {
              "color": "#b7a284"
            },
            ".mbr-section-subtitle": {
              "color": "#b7a284",
              "text-align": "center"
            },
            ".number": {
              "color": "#b7a284",
              "font-weight": "bold"
            },
            ".number:hover": {
              "color": "#b7a284"
            },
            ".social_out": {
              "display": "flex",
              "@media (max-width: 765px)": {
                "display": "block"
              },
              "margin-top": "1rem"
            },
            ".email": {
              "transition": ".2s all"
            },
            ".email:hover": {
              "color": "#b7a284"
            },
            ".copyright": {
              "color": "#b7a284",
              "& when not (@showSocial)": {
                "width": "100%"
              }
            },
            ".mbr-section-subtitle P": {
              "text-align": "center",
              "@media (max-width: 765px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-subtitle DIV": {
              "text-align": "center",
              "@media (max-width: 765px)": {
                "text-align": "center"
              }
            },
            ".copyright P": {
              "vertical-align": "sub",
              "display": "inline-block",
              "color": "#b7a284",
              "text-align": "center"
            },
            ".socicon": {
              "color": "#b7a284"
            },
            ".icons": {
              "width": "18px",
              "height": "20px"
            },
            ".href": {
              "padding-bottom": "1.5rem"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "footer1",
          "_sourceTheme": "grocerym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Logo Size\" name=\"logoSize\" min=\"1\" max=\"5\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" condition=\"showSocial\" checked=\"\">\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked=\"\">\n          <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked=\"\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background17.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background17.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mbr-white footer-sotial\">\n           \n            <div class=\"col-12 col-md-4 col-lg-3\">\n\n        \n                \n               <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline=\"\" mbr-article=\"\">\n                    <li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"index.html#people03-k\" class=\"text-primary\">אודות</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"index.html#features09-27\" class=\"text-primary\">השירותים שלי</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"workshops.html\" class=\"text-primary\">הסדנאות</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"articles.html\" class=\"text-primary\">מאמרים</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"index.html#contacts3-s\" class=\"text-primary\">צרו קשר</a></li>\n                </ul>\n               \n            </div>\n <div class=\"col-6 col-md-4 col-lg-3\">\n                <div class=\"media-wrap col-md-{{1*logoSize}} col-12\">\n                    \n                        <img src=\"@PROJECT_PATH@/assets/images/logo-198.jpg\" alt=\"מרכז למידה מא-ת\">\n                    \n                </div>\n            </div>\n            \n            <div class=\"col-12 col-md-4 col-lg-3 rigth-col\">\n                \n    <h5 mbr-text=\"\" class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">צרו קשר</h5>\n                    <h5 mbr-text=\"\" class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\"><a href=\"tel:+972543982557\" class=\"text-primary\">054-398-2557</a></h5>\n                \n            </div>\n            <div class=\"col-12 social_out footer-sotial \">\n                <div class=\"  mb-0 mbr-fonts-style copyright align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\" mbr-if=\"showCopyright\">\n                    © כל הזכויות שמורות להדר נזרית-ראובן\n                </div>\n                <div class=\"flex\"><h5 class=\" mbr-fonts-style mb-3 follow\" mbr-theme-style=\"display-7\" data-app-selector=\".follow\" mbr-if=\"showTitle &amp;&amp; showSocial\">עקבו אחרינו</h5>\n                <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a class=\"icons\" href=\"https://www.instagram.com/merkaz_lemida_a_t/\" target=\"_blank\">\n                            <span mbr-icon=\"\" class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a class=\"icons\" href=\"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/\" target=\"_blank\">\n                            <span mbr-icon=\"\" class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a class=\"icons\" href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon=\"\" class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                       </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
