  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "הוראה מתקנת והכנה לכיתה א' בבאר שבע | מרכז למידה מא-ת",
        "meta_descr": "מרכז למידה מא-ת בבאר שבע: הוראה מתקנת בקבוצות קטנות, הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו' וחיזוק קריאה. 15 שנות ניסיון. השאירו פרטים.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://merkaz-lamida-a-t.com/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"מרכז למידה מא-ת\">\n<meta property=\"og:url\" content=\"https://merkaz-lamida-a-t.com/\">\n<meta property=\"og:title\" content=\"הוראה מתקנת והכנה לכיתה א' בבאר שבע | מרכז למידה מא-ת\">\n<meta property=\"og:description\" content=\"מרכז למידה מא-ת בבאר שבע: הוראה מתקנת בקבוצות קטנות, הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו' וחיזוק קריאה. 15 שנות ניסיון. השאירו פרטים.\">\n<meta property=\"og:image\" content=\"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n    \"LocalBusiness\",\n    \"EducationalOrganization\"\n  ],\n  \"name\": \"מרכז למידה מא-ת\",\n  \"description\": \"מרכז למידה מא-ת בבאר שבע: הוראה מתקנת בקבוצות קטנות, הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו' וחיזוק קריאה. 15 שנות ניסיון. השאירו פרטים.\",\n  \"url\": \"https://merkaz-lamida-a-t.com/\",\n  \"logo\": \"https://merkaz-lamida-a-t.com/assets/images/logo-211.jpg\",\n  \"image\": \"https://merkaz-lamida-a-t.com/assets/images/hadar-nazrit-reuven.jpg\",\n  \"telephone\": \"+972-54-398-2557\",\n  \"email\": \"hadar30484@walla.com\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"מתנ״ס הרוח היהודית\",\n    \"addressLocality\": \"באר שבע\",\n    \"addressCountry\": \"IL\"\n  },\n  \"areaServed\": \"באר שבע\",\n  \"founder\": {\n    \"@type\": \"Person\",\n    \"name\": \"הדר נזרית-ראובן\",\n    \"jobTitle\": \"מורה להוראה מתקנת\"\n  },\n  \"sameAs\": [\n    \"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/\",\n    \"https://www.instagram.com/merkaz_lemida_a_t/\"\n  ]\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"לאילו גילאים מתאים מרכז הלמידה?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"הכנה לכיתה א' מיועדת לילדי גן חובה. קבוצות דיוק ושטף בקריאה ובכתיבה מיועדות לכיתות א'-ג', וקורס מתמטיקה ושפה מיועד לכיתות ב'-ו'.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"איפה המרכז נמצא?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"מרכז למידה מא-ת פועל במתנ\\\"ס הרוח היהודית בבאר שבע.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"איך בנויה הלמידה במרכז?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"הלמידה מתקיימת בקבוצות קטנות. כל תלמיד מקבל תוכנית עבודה אישית לצמצום פערים, יחד עם חיזוק הביטחון העצמי והמוכנות הרגשית.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"מי מלמדת במרכז?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"הדר נזרית-ראובן, בעלת תואר ראשון בחינוך מיוחד ו-15 שנות ניסיון בהוראה מתקנת.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"אפשר לתרגל גם בבית?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"כן. ערכת ההכנה לכיתה א' של המרכז כוללת משחקים דידקטיים וחוברות פעילות בשפה ובחשבון לתרגול בבית.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"איך מצטרפים?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"משאירים פרטים בטופס באתר, מתקשרים ל-054-398-2557 או כותבים בוואטסאפ, ונחזור אליכם לשיחת ייעוץ.\"\n      }\n    }\n  ]\n}\n</script>",
