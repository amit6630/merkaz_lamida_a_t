              "font-weight": "700",
              "margin-bottom": "1rem"
            },
            ".ma-art-title": {
              "color": "@textColor",
              "margin-bottom": "1rem",
              "line-height": "1.2"
            },
            ".ma-lead": {
              "color": "#5b5446",
              "margin-bottom": "1rem",
              "line-height": "1.6"
            },
            ".ma-byline": {
              "color": "#8a8170",
              "font-size": "1rem",
              "margin": "0"
            },
            ".ma-hero": {
              "margin": "2.5rem 0",
              "border-radius": "26px",
              "overflow": "hidden",
              "box-shadow": "0 24px 50px -28px rgba(58, 52, 28, .45)"
            },
            ".ma-hero img": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-height": "520px",
              "object-fit": "cover",
              "border-radius": "0"
            },
            ".ma-content h2": {
              "color": "@textColor",
              "margin": "2.5rem 0 1rem",
              "padding-right": "14px",
              "border-right": "4px solid @mainColor"
            },
            ".ma-content p": {
              "color": "#3f3a2c",
              "line-height": "1.85",
              "margin-bottom": "1.1rem"
            },
            ".ma-content ul": {
              "margin": "0 0 1.4rem",
              "padding-right": "1.25rem",
              "padding-left": "0"
            },
            ".ma-content li": {
              "color": "#3f3a2c",
              "line-height": "1.8",
              "margin-bottom": ".5rem"
            },
            ".ma-content li::marker": {
              "color": "@mainColor"
            },
            ".ma-cta": {
              "margin-top": "3rem",
              "padding": "32px 28px",
              "border-radius": "24px",
              "background": "@mainColor",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".ma-cta-title": {
              "color": "#ffffff",
              "margin-bottom": ".5rem"
            },
            ".ma-cta-text": {
              "color": "#ffffff",
              "opacity": ".92",
              "margin-bottom": "0"
            },
            ".ma-cta .mbr-section-btn": {
              "margin-top": "1.25rem"
            },
            ".ma-cta .btn-white": {
              "color": "#3a341c !important"
            },
            ".ma-related": {
              "margin-top": "3.5rem"
            },
            ".ma-related-title": {
              "color": "@textColor",
              "margin-bottom": "1.25rem"
            },
            ".ma-related-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px"
            },
            "@media (min-width: 768px)": {
              ".ma-related-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            ".ma-related-card": {
              "display": "flex",
              "gap": "14px",
              "align-items": "center",
              "padding": "12px",
              "background": "#ffffff",
              "border-radius": "18px",
              "text-decoration": "none",
              "box-shadow": "0 12px 30px -22px rgba(58, 52, 28, .4)",
              "transition": "transform .3s ease"
            },
            ".ma-related-card:hover": {
              "transform": "translateY(-4px)"
            },
            ".ma-related-card img": {
              "width": "84px",
              "height": "84px",
              "object-fit": "cover",
              "border-radius": "14px",
              "flex": "none"
            },
            ".ma-related-card span": {
              "color": "@textColor",
              "font-weight": "700",
              "line-height": "1.4",
              "font-size": "1.05rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-article\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"ma-wrap\">\n      <nav class=\"ma-crumbs\" aria-label=\"מיקום בעמוד\"><a href=\"index.html\">דף הבית</a><span aria-hidden=\"true\">/</span><a href=\"articles.html\">מאמרים</a></nav>\n      <span class=\"ma-tag\" mbr-text data-app-selector=\".ma-tag\">קריאה ולמידה</span>\n      <h1 class=\"ma-art-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-text data-app-selector=\".ma-art-title\"><strong>דיוק ושטף בקריאה, ואסטרטגיות למידה בשפה ובחשבון</strong></h1>\n      <p class=\"ma-lead mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-lead\">מה ההבדל בין דיוק לשטף בקריאה? למה שניהם חשובים להבנת הנקרא, ואילו אסטרטגיות למידה עוזרות לילדים להצליח בשפה ובחשבון.</p>\n      <p class=\"ma-byline\" mbr-text data-app-selector=\".ma-byline\">מאת הדר נזרית-ראובן, מורה להוראה מתקנת · מרכז למידה מא-ת, באר שבע</p>\n      <figure class=\"ma-hero\"><img src=\"@PROJECT_PATH@/assets/images/service-reading-fluency.jpg\" alt=\"ילד מתרגל קריאה במרכז מא-ת\"></figure>\n      <div class=\"ma-content\">\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">קריאה וכתיבה הן מיומנויות חובה לכל החיים, והן הבסיס להצלחה בלימודים. ילד שקורא לאט ובמאמץ משקיע את כל האנרגיה בפענוח המילים, ולא נשאר לו כוח להבין מה קרא. לכן כשאנחנו מדברים על קריאה טובה, אנחנו מדברים על שני מרכיבים: <strong>דיוק</strong> ו<strong>שטף</strong>.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה דיוק בקריאה?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">דיוק הוא היכולת לקרוא את המילה כפי שהיא כתובה: לזהות נכון את האותיות ואת סימני הניקוד, ולא להחליף, להשמיט או \"לנחש\" מילים. ילד שקורא \"בית\" במקום \"בת\", או מדלג על סופי מילים, עלול להבין את הטקסט לא נכון גם אם הוא קורא מהר.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>מה זה שטף בקריאה?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">שטף הוא היכולת לקרוא בקצב טבעי, ברצף ובהטעמה נכונה, כמעט כמו בדיבור. כשהקריאה שוטפת, הפענוח הופך לאוטומטי, והראש מתפנה להבנה. שטף לא אומר \"לקרוא הכי מהר שאפשר\". הוא אומר לקרוא בקצב שמאפשר להבין.</p>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>סימנים לקושי בדיוק או בשטף</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\">הילד קורא לאט מאוד, מילה אחרי מילה, או חוזר על אותה מילה כמה פעמים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מחליף אותיות דומות (ב/כ, ד/ר, ה/ח) או מתבלבל בניקוד.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מנחש מילים לפי האות הראשונה או לפי התמונה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא מתעייף מהר מקריאה ונמנע ממנה.</li>\n        <li mbr-text data-app-selector=\".ma-content li\">הוא \"קרא\" את הטקסט אבל לא יודע לספר מה היה בו.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך מחזקים דיוק ושטף?</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>חיזוק הבסיס הצלילי:</strong> תרגול הקשר בין אות לצליל, פירוק והרכבה של הברות ומילים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה חוזרת:</strong> לקרוא את אותו קטע קצר כמה פעמים. בכל פעם הקריאה נעשית מדויקת ושוטפת יותר, והילד מרגיש את ההתקדמות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>קריאה בזוגות ובמקהלה:</strong> המבוגר קורא משפט והילד חוזר אחריו, או שקוראים יחד. כך הילד שומע איך נשמעת קריאה שוטפת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>טקסטים ברמה המתאימה:</strong> לא קלים מדי ולא קשים מדי, כדי שהילד יצליח ויתקדם.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>עבודה בצעדים קטנים:</strong> הצלחות קטנות ועקביות בונות ביטחון, והביטחון בונה מוטיבציה.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>אסטרטגיות למידה בשפה</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לפני הקריאה:</strong> להסתכל על הכותרת ועל התמונות ולשאול \"על מה הטקסט הזה, לדעתי?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>בזמן הקריאה:</strong> לעצור בסוף פסקה ולשאול \"מה הבנתי עד עכשיו?\".</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>אחרי הקריאה:</strong> לספר את הטקסט במילים שלי, לסמן את המשפט החשוב ולענות על שאלות.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>בכתיבה:</strong> לתכנן לפני שכותבים (מה אני רוצה להגיד), לכתוב, ואז לקרוא שוב ולתקן.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>אסטרטגיות למידה בחשבון</strong></h2>\n      <ul class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>להבין לפני שמשננים:</strong> להשתמש בחפצים, בציורים ובקווי מספרים כדי שהילד יראה מה קורה בתרגיל.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לקרוא את השאלה פעמיים:</strong> בבעיות מילוליות, לסמן מה נתון ומה שואלים. בדיוק כאן הקריאה והחשבון נפגשים.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>פירוק לשלבים:</strong> בעיה אחת גדולה היא אוסף של בעיות קטנות. פותרים אחת-אחת.</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לבדוק את התשובה:</strong> האם התוצאה הגיונית? אפשר לבדוק בדרך אחרת?</li>\n        <li mbr-text data-app-selector=\".ma-content li\"><strong>לתרגל באופן עצמאי:</strong> בהדרגה, הילד לומד לפתור לבד ולסמוך על עצמו.</li>\n      </ul>\n      <h2 class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-content h2\"><strong>איך אנחנו עובדים במרכז מא-ת?</strong></h2>\n      <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-content p\">במרכז למידה מא-ת פועלות קבוצות קטנות לחיזוק דיוק ושטף בקריאה ובכתיבה לילדי כיתות א'-ג', וקבוצות במתמטיקה ובשפה לכיתות ב'-ו'. הדר נזרית-ראובן משלבת שיטת למידה מתקדמת וחווייתית, בונה לכל תלמיד תוכנית אישית לצמצום פערים, ומקפידה על מעטפת רגשית שמחזקת את הביטחון העצמי. כי כשהילד מרגיש שרואים אותו, הלמידה מתחילה לזרום.</p>\n      </div>\n      <aside class=\"ma-cta\">\n        <h2 class=\"ma-cta-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-cta-title\"><strong>חושבים שהילד שלכם צריך חיזוק בקריאה או בחשבון?</strong></h2>\n        <p class=\"ma-cta-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-text data-app-selector=\".ma-cta-text\">השאירו פרטים באתר או התקשרו ל-054-398-2557, ונשמח לענות על כל שאלה ולבנות תוכנית מתאימה.</p>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"tel:+972543982557\" data-app-placeholder=\"Type Text\">054-398-2557</a> <a class=\"btn btn-white-outline\" href=\"index.html#form02-9\" data-app-placeholder=\"Type Text\">השאירו פרטים</a></div>\n      </aside>\n      <div class=\"ma-related\">\n        <h2 class=\"ma-related-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".ma-related-title\"><strong>מאמרים נוספים</strong></h2>\n        <div class=\"ma-related-grid\">\n        <a class=\"ma-related-card\" href=\"article-first-grade.html\"><img src=\"@PROJECT_PATH@/assets/images/service-first-grade.jpg\" alt=\"ילדה מתרגלת כתיבה לקראת כיתה א'\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מגן חובה לכיתה א'</span></a>\n        <a class=\"ma-related-card\" href=\"article-middle-school.html\"><img src=\"@PROJECT_PATH@/assets/images/service-math-language.jpg\" alt=\"תלמידים לומדים מתמטיקה ושפה במרכז מא-ת\" loading=\"lazy\"><span mbr-text data-app-selector=\".ma-related-card span\">המעבר מיסודי לחטיבת ביניים</span></a>\n        </div>\n        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary-outline\" href=\"articles.html\" data-app-placeholder=\"Type Text\">לכל המאמרים</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_anchor": "ma-article-2g",
          "_isUserblock": true,
          "_cid": "vJFrCfZ4U2",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "ma-footer",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding": "clamp(48px, 6vw, 72px) 0 0",
            "background-color": "@bgColor",
            "direction": "rtl",
            "color": "rgba(248, 244, 238, .78)",
            "background-image": "radial-gradient(700px 300px at 85% 0%, rgba(183, 162, 132, .18), transparent 70%)",
            ".ma-fwrap": {
              "max-width": "1200px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 40px)"
            },
            ".ma-fgrid": {
              "display": "grid",
              "grid-template-columns": "1.4fr 1fr 1fr 1.2fr",
              "gap": "36px"
            },
            ".ma-flogo img": {
              "width": "170px",
              "height": "auto",
              "border-radius": "18px !important",
              "padding": "10px",
              "background": "#f8f4ee"
            },
            ".ma-ftext": {
              "margin": "16px 0",
              "line-height": "1.7",
              "font-size": ".98rem",
              "max-width": "32ch"
            },
            ".ma-fsocial": {
              "display": "flex",
              "gap": "10px"
            },
            ".ma-fsocial a": {
              "width": "42px",
              "height": "42px",
              "border-radius": "50%",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid rgba(248, 244, 238, .22)",
              "color": "#f8f4ee !important",
              "text-decoration": "none !important",
              "transition": "background .25s"
            },
            ".ma-fsocial a:hover": {
              "background": "@accentColor"
            },
            ".ma-fhead": {
              "color": "#f8f4ee",
              "font-size": "1.1rem",
              "font-weight": "600",
              "margin": "6px 0 14px"
            },
            ".ma-fcol ul": {
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-fcol li": {
              "margin-bottom": "9px"
            },
            ".ma-fcol a, .ma-fcol span": {
              "color": "rgba(248, 244, 238, .78) !important",
              "text-decoration": "none !important",
              "font-size": ".98rem"
            },
            ".ma-fcol a:hover": {
              "color": "@accentColor !important"
            },
            ".ma-fcta": {
              "display": "inline-block",
              "margin-top": "8px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "background": "@accentColor",
              "color": "#2f2a18 !important",
              "font-weight": "600",
              "font-size": ".98rem"
            },
            ".ma-fbottom": {
              "margin-top": "40px",
              "padding-top": "18px",
              "border-top": "1px solid rgba(248, 244, 238, .14)",
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "space-between",
              "gap": "10px",
              "font-size": ".88rem",
              "margin-bottom": "22px"
            },
            ".ma-fbottom p": {
              "margin": "0",
              "color": "rgba(248, 244, 238, .6)"
            },
            ".ma-fbottom a": {
              "color": "rgba(248, 244, 238, .75) !important",
              "text-decoration": "none !important"
            },
            ".ma-fbottom a:hover": {
              "color": "@accentColor !important"
            },
            "@media (max-width: 991px)": {
              ".ma-fgrid": {
                "grid-template-columns": "1fr 1fr"
              },
              ".ma-fbrand": {
                "grid-column": "1 / -1"
              }
            },
            "@media (max-width: 575px)": {
              ".ma-fgrid": {
                "gap": "26px"
              },
              ".ma-fbottom": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".ma-fcol:last-child": {
                "grid-column": "1 / -1"
              }
            },
            ".ma-fcredit": {
              "background": "#b7a284",
              "text-align": "center",
              "padding": "14px 16px",
              "font-size": ".95rem"
            },
            ".ma-fcredit a": {
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".ma-fcredit a:hover": {
              "text-decoration": "underline !important"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-footer\" group=\"Custom\" global once=\"footers\">\n  <mbr-parameters>\n    <header>Colors</header>\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#2f2a18\">\n    <input type=\"color\" title=\"Accent\" name=\"accentColor\" value=\"#b7a284\">\n  </mbr-parameters>\n  <div class=\"ma-fwrap\">\n    <div class=\"ma-fgrid\">\n      <div class=\"ma-fbrand\">\n        <a href=\"index.html\" class=\"ma-flogo\"><img src=\"@PROJECT_PATH@/assets/images/logo-card.jpg\" alt=\"מא' ועד ת' – הדר נזרית-ראובן\" width=\"680\" height=\"430\"></a>\n        <p class=\"ma-ftext\" mbr-text>מרכז למידה בבאר שבע: הוראה מתקנת, הכנה לכיתה א', מתמטיקה ושפה לכיתות ב'-ו', ודיוק ושטף בקריאה.</p>\n        <div class=\"ma-fsocial\">\n          <a href=\"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/\" target=\"_blank\" rel=\"noopener\" aria-label=\"פייסבוק\"><span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span></a>\n          <a href=\"https://www.instagram.com/merkaz_lemida_a_t/\" target=\"_blank\" rel=\"noopener\" aria-label=\"אינסטגרם\"><span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span></a>\n          <a href=\"https://wa.me/972543982557\" target=\"_blank\" rel=\"noopener\" aria-label=\"וואטסאפ\"><span mbr-icon class=\"mbr-iconfont socicon-whatsapp socicon\"></span></a>\n        </div>\n      </div>\n      <div class=\"ma-fcol\">\n        <h3 class=\"ma-fhead\" mbr-text>ניווט</h3>\n        <ul><li><a href=\"index.html\">דף הבית</a></li><li><a href=\"workshops.html\">הסדנאות</a></li><li><a href=\"articles.html\">מאמרים</a></li><li><a href=\"index.html#faq\">שאלות נפוצות</a></li><li><a href=\"card.html\">כרטיס ביקור</a></li></ul>\n      </div>\n      <div class=\"ma-fcol\">\n        <h3 class=\"ma-fhead\" mbr-text>הסדנאות</h3>\n        <ul><li><a href=\"workshops.html#timeline3-g\">הכנה לכיתה א'</a></li><li><a href=\"workshops.html#timeline3-y\">מתמטיקה ושפה (ב'-ו')</a></li><li><a href=\"workshops.html#timeline3-15\">דיוק ושטף בקריאה (א'-ג')</a></li></ul>\n      </div>\n      <div class=\"ma-fcol\">\n        <h3 class=\"ma-fhead\" mbr-text>צרו קשר</h3>\n        <ul><li><a href=\"tel:+972543982557\" dir=\"ltr\">054-398-2557</a></li><li><a href=\"mailto:hadar30484@walla.com\">hadar30484@walla.com</a></li><li><span>מתנ\"ס הרוח היהודית, באר שבע</span></li></ul>\n        <a class=\"ma-fcta\" href=\"index.html#form02-9\">לשיחת ייעוץ</a>\n      </div>\n    </div>\n    <div class=\"ma-fbottom\">\n      <p class=\"ma-fcopy\" mbr-text>© כל הזכויות שמורות להדר נזרית-ראובן</p>\n      <p class=\"ma-flegal\"><a href=\"privacy.html\">מדיניות פרטיות</a> · <a href=\"terms.html\">תנאי שימוש</a> · <a href=\"card.html\">כרטיס ביקור</a></p>\n    </div>\n  </div>\n  <div class=\"ma-fcredit\"><a href=\"https://thebwas.com\" target=\"_blank\" rel=\"noopener\">האתר נבנה על ידי עמית שכטר</a>, <a href=\"tel:+972537155757\" dir=\"ltr\">053-715-5757</a></div>\n</section>",
