              "margin-bottom": "1rem",
              "line-height": "1.6"
            },
            ".ma-byline": {
              "color": "#8a8170",
              "font-size": "1rem",
              "margin": "0"
            },
            ".ma-hero": {
              "margin": "2.5rem 0",
              "border-radius": "26px",
              "overflow": "hidden",
              "box-shadow": "0 24px 50px -28px rgba(58, 52, 28, .45)"
            },
            ".ma-hero img": {
