          "_name": "footer1",
          "_sourceTheme": "grocerym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Logo Size\" name=\"logoSize\" min=\"1\" max=\"5\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" condition=\"showSocial\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n          <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background17.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background17.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mbr-white footer-sotial\">\n           \n            <div class=\"col-12 col-md-4 col-lg-3\">\n\n        \n                \n               <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"index.html#people03-k\" class=\"text-primary\">אודות</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><a href=\"index.html#slider5-8\" class=\"text-primary\">השירותים שלי</a></li><li class=\"mbr-text mbr-semibold item-wrap\"><span style=\"font-size: 1.5rem;\"><a href=\"index.html#contacts3-s\" class=\"text-primary\">צרו קשר</a></span></li>\n                </ul>\n               \n            </div>\n <div class=\"col-6 col-md-4 col-lg-3\">\n                <div class=\"media-wrap col-md-{{1*logoSize}} col-12\">\n                    \n                        <img src=\"@PROJECT_PATH@/assets/images/-whatsapp-2024-03-26-21.53.58-a170a1e2-198x198.jpg\" alt>\n                    \n                </div>\n            </div>\n            \n            <div class=\"col-12 col-md-4 col-lg-3 rigth-col\">\n                \n    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">צרו קשר</h5>\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\"><a href=\"tel:+972543982557\" class=\"text-primary\">054-398-2557</a></h5>\n                \n            </div>\n            <div class=\"col-12 social_out footer-sotial \">\n                <div class=\"  mb-0 mbr-fonts-style copyright align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\" mbr-if=\"showCopyright\">\n                    © כל הזכויות שמורות להדר ניזרית ראובן\n                </div>\n                <div class=\"flex\"><h5 class=\" mbr-fonts-style mb-3 follow\" mbr-theme-style=\"display-7\" data-app-selector=\".follow\" mbr-if=\"showTitle && showSocial\">עקבו אחרינו&nbsp; &nbsp; &nbsp;&nbsp;</h5>\n                <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a class=\"icons\" href=\"https://www.instagram.com/merkaz_lemida_a_t/\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a class=\"icons\" href=\"https://www.facebook.com/p/%D7%9E%D7%90-%D7%AA-%D7%9E%D7%A8%D7%9B%D7%96-%D7%9C%D7%9E%D7%99%D7%93%D7%94-%D7%91%D7%94%D7%A0%D7%94%D7%9C%D7%AA-%D7%94%D7%93%D7%A8-%D7%A0%D7%96%D7%A8%D7%99%D7%AA-%D7%A8%D7%90%D7%95%D7%91%D7%9F-100088353079240/?locale=gn_PY&paipv=0&eav=AfZjWfHvZG6lv_qdFe0Yr42zKv6S393KMIcg8bAN_BkFrmftFVj0LQmKE1Bc9VgxDOs&_rdr\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a class=\"icons\" href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                       </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
