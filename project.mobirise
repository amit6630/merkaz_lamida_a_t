              "background": "#ffffff",
              "overflow": "visible"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ma-nav\" group=\"Custom\" global once=\"menu\" always-top not-draggable>\n  <mbr-parameters>\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#9a8262\">\n    <input type=\"color\" title=\"Text\" name=\"textColor\" value=\"#3a341c\">\n  </mbr-parameters>\n  <input type=\"checkbox\" id=\"maNavToggle\" class=\"ma-toggle\" aria-label=\"פתיחת התפריט\">\n  <div class=\"ma-bar\">\n    <a class=\"ma-logo\" href=\"index.html\" aria-label=\"מרכז למידה מא-ת – דף הבית\"><img src=\"@PROJECT_PATH@/assets/images/logo-card.jpg\" alt=\"מא' ועד ת' – הדר נזרית-ראובן\" width=\"680\" height=\"430\"></a>\n    <nav class=\"ma-menu\" aria-label=\"תפריט ראשי\"><ul class=\"ma-links\"><li class=\"ma-has-sub\"><a class=\"ma-link\" href=\"workshops.html\" mbr-text>הסדנאות</a><ul class=\"ma-sub\"><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-g\" mbr-text>הכנה לכיתה א'</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-y\" mbr-text>מתמטיקה ושפה (ב'-ו')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-15\" mbr-text>דיוק ושטף בקריאה (א'-ג')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html\" mbr-text>כל הסדנאות</a></li></ul></li><li><a class=\"ma-link\" href=\"index.html#slider01-1s\" mbr-text>ערכת ההכנה</a></li><li><a class=\"ma-link\" href=\"index.html#people03-k\" mbr-text>אודות</a></li><li><a class=\"ma-link\" href=\"articles.html\" mbr-text>מאמרים</a></li><li><a class=\"ma-link\" href=\"index.html#faq\" mbr-text>שאלות נפוצות</a></li><li><a class=\"ma-link\" href=\"index.html#contacts3-s\" mbr-text>צור קשר</a></li></ul></nav>\n    <div class=\"ma-actions\">\n      <a class=\"ma-phone\" href=\"tel:+972543982557\" aria-label=\"התקשרו 054-398-2557\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\"></span><span class=\"ma-phone-num\" dir=\"ltr\">054-398-2557</span></a>\n      <a class=\"ma-cta\" href=\"index.html#form02-9\" mbr-text>לשיחת ייעוץ</a>\n      <label for=\"maNavToggle\" class=\"ma-burger\" aria-label=\"תפריט\"><span></span><span></span><span></span></label>\n    </div>\n  </div>\n  <div class=\"ma-panel\">\n    <ul class=\"ma-plinks\"><li class=\"ma-has-sub\"><a class=\"ma-link\" href=\"workshops.html\" mbr-text>הסדנאות</a><ul class=\"ma-sub\"><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-g\" mbr-text>הכנה לכיתה א'</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-y\" mbr-text>מתמטיקה ושפה (ב'-ו')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html#timeline3-15\" mbr-text>דיוק ושטף בקריאה (א'-ג')</a></li><li><a class=\"ma-sublink\" href=\"workshops.html\" mbr-text>כל הסדנאות</a></li></ul></li><li><a class=\"ma-link\" href=\"index.html#slider01-1s\" mbr-text>ערכת ההכנה</a></li><li><a class=\"ma-link\" href=\"index.html#people03-k\" mbr-text>אודות</a></li><li><a class=\"ma-link\" href=\"articles.html\" mbr-text>מאמרים</a></li><li><a class=\"ma-link\" href=\"index.html#faq\" mbr-text>שאלות נפוצות</a></li><li><a class=\"ma-link\" href=\"index.html#contacts3-s\" mbr-text>צור קשר</a></li></ul>\n    <div class=\"ma-pfoot\"><a class=\"ma-cta\" href=\"index.html#form02-9\">לשיחת ייעוץ</a><a class=\"ma-pphone\" href=\"tel:+972543982557\" dir=\"ltr\">054-398-2557</a></div>\n  </div>\n</section>",
