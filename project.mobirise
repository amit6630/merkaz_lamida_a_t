            ".row": {
              "justify-content": "space-between",
              "align-items": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "36px"
                },
                "color": "#4a4a4a",
                "font-weight": "700",
                "letter-spacing": "-0.02em"
              },
              "margin-bottom": "3rem"
            },
            ".content-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "@media (max-width: 992px)": {
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  ".item-img": {
                    "order": "-1"
                  },
                  ".mbr-text": {
