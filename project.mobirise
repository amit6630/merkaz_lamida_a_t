              "gap": "10px"
            },
            ".ma-fsocial a": {
              "width": "42px",
              "height": "42px",
              "border-radius": "50%",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid rgba(248, 244, 238, .22)",
              "color": "#f8f4ee !important",
              "text-decoration": "none !important",
              "transition": "background .25s"
            },
            ".ma-fsocial a:hover": {
              "background": "@accentColor"
            },
            ".ma-fhead": {
              "color": "#f8f4ee",
              "font-size": "1.1rem",
              "font-weight": "600",
              "margin": "6px 0 14px"
            },
            ".ma-fcol ul": {
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".ma-fcol li": {
              "margin-bottom": "9px"
            },
            ".ma-fcol a, .ma-fcol span": {
              "color": "rgba(248, 244, 238, .78) !important",
              "text-decoration": "none !important",
              "font-size": ".98rem"
            },
            ".ma-fcol a:hover": {
              "color": "@accentColor !important"
            },
            ".ma-fcta": {
              "display": "inline-block",
              "margin-top": "8px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "background": "@accentColor",
              "color": "#2f2a18 !important",
              "font-weight": "600",
              "font-size": ".98rem"
            },
            ".ma-fbottom": {
              "margin-top": "40px",
              "padding-top": "18px",
              "border-top": "1px solid rgba(248, 244, 238, .14)",
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "space-between",
              "gap": "10px",
              "font-size": ".88rem",
              "margin-bottom": "22px"
            },
            ".ma-fbottom p": {
              "margin": "0",
              "color": "rgba(248, 244, 238, .6)"
            },
            ".ma-fbottom a": {
              "color": "rgba(248, 244, 238, .75) !important",
              "text-decoration": "none !important"
            },
            ".ma-fbottom a:hover": {
              "color": "@accentColor !important"
            },
            "@media (max-width: 991px)": {
              ".ma-fgrid": {
                "grid-template-columns": "1fr 1fr"
              },
              ".ma-fbrand": {
                "grid-column": "1 / -1"
              }
            },
            "@media (max-width: 575px)": {
              ".ma-fgrid": {
                "gap": "26px"
              },
              ".ma-fbottom": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".ma-fcol:last-child": {
                "grid-column": "1 / -1"
              }
            },
            ".ma-fcredit": {
              "background": "#b7a284",
              "text-align": "center",
              "padding": "14px 16px",
              "font-size": ".95rem"
            },
            ".ma-fcredit a": {
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".ma-fcredit a:hover": {
